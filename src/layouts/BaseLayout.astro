---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Optional page-level JSON-LD node(s) — merged into the @graph so a
   *  project page can add a CreativeWork, a publication a ScholarlyArticle,
   *  etc. Accepts a single object or an array. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "David Chen — AI/ML engineer & computational designer. Computer vision, latent spaces, and tools at the seam of generative AI and design. CMU MSCD.",
  image = "/og-default.png",
  structuredData,
} = Astro.props;

const siteName = "David Chen";
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// ── Structured data (JSON-LD) ────────────────────────────────────────────
// A stable Person + WebSite graph is emitted on every page (helps entity
// resolution + knowledge-panel eligibility for a personal site). Page-level
// nodes passed via `structuredData` are appended. Facts sourced from the
// About page + vault _Facts (AI/ML Engineer at HILOS, CMU MSCD, Rice B.Arch).
const personNode = {
  "@type": "Person",
  "@id": new URL("/#person", Astro.site).toString(),
  name: "David Chen",
  alternateName: ["Tianle Chen", "陈天乐"],
  url: Astro.site?.toString(),
  jobTitle: "AI/ML Engineer",
  worksFor: { "@type": "Organization", name: "HILOS Studio" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Carnegie Mellon University" },
    { "@type": "CollegeOrUniversity", name: "Rice University" },
  ],
  knowsAbout: [
    "Machine Learning",
    "Computer Vision",
    "Computational Design",
    "Generative AI",
    "Latent Spaces",
    "Design Tooling",
    "Human-Computer Interaction",
  ],
  sameAs: [
    "https://www.linkedin.com/in/tianle-david-chen/",
    "https://github.com/chentianle1117",
  ],
};
const websiteNode = {
  "@type": "WebSite",
  "@id": new URL("/#website", Astro.site).toString(),
  url: Astro.site?.toString(),
  name: siteName,
  description,
  publisher: { "@id": new URL("/#person", Astro.site).toString() },
};
const extraNodes = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personNode, websiteNode, ...extraNodes],
};
---

<!doctype html>
<html lang="en" data-theme="dark" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Pre-paint theme hydration — runs before body to avoid flash of wrong theme.
        Sets BOTH `data-theme` attribute (Phase 2 contract) AND `.dark`/`.light`
        class (legacy components). */}
    <script is:inline>
      (function () {
        // Convention-based light/dark image swap: hardcoded-dark SVGs (project
        // covers + architecture diagrams) each have a `*-light.svg` twin. In
        // light mode we point the <img> at the twin. No per-image markup needed.
        var IMG_RE = /^(\/assets\/[^?#]*?(?:cover|architecture|d[1-4]-[a-z-]+))(-light)?\.svg$/;
        function themeImages(theme) {
          var imgs = document.images;
          for (var i = 0; i < imgs.length; i++) {
            var s = imgs[i].getAttribute("src") || "";
            var m = s.match(IMG_RE);
            if (!m) continue;
            var want = m[1] + (theme === "light" ? "-light" : "") + ".svg";
            if (s !== want) imgs[i].setAttribute("src", want);
          }
        }
        function currentTheme() {
          try { return localStorage.getItem("theme") || "dark"; } catch (e) { return "dark"; }
        }
        function applyTheme() {
          var theme = currentTheme();
          var root = document.documentElement;
          root.setAttribute("data-theme", theme);
          root.classList.remove("dark", "light");
          root.classList.add(theme);
          themeImages(theme);
        }
        applyTheme();
        // Re-apply after every View-Transition navigation — WITHOUT this the
        // swapped-in page ships its hardcoded class="dark" and the chosen theme
        // silently reverts. after-swap runs before paint, so no flash.
        document.addEventListener("astro:after-swap", applyTheme);
        // Swap late/lazy images once loaded, and whenever the toggle fires.
        document.addEventListener("astro:page-load", function () { themeImages(currentTheme()); });
        window.addEventListener("theme-change", function (e) {
          themeImages((e && e.detail && e.detail.theme) || currentTheme());
        });
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <meta name="generator" content={Astro.generator} />

    {/* Structured data — Person + WebSite (+ optional page nodes) */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ViewTransitions />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class="min-h-[70vh]">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll IntersectionObserver, staggered between siblings under [data-stagger]
      const initReveal = () => {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
        if (reduced) {
          targets.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const parent = el.closest<HTMLElement>("[data-stagger]");
                if (parent) {
                  const siblings = Array.from(
                    parent.querySelectorAll<HTMLElement>("[data-reveal]")
                  );
                  const idx = siblings.indexOf(el);
                  el.style.transitionDelay = `${Math.max(0, idx) * 60}ms`;
                }
                el.classList.add("is-visible");
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.15 }
        );
        targets.forEach((el) => observer.observe(el));
      };
      initReveal();
      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
