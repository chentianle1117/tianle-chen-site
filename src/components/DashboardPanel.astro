---
interface Props {
  label: string;
  span?: number;
}
const { label, span = 4 } = Astro.props;

const spanClass: Record<number, string> = {
  3: "md:col-span-3",
  4: "md:col-span-4",
  5: "md:col-span-5",
  6: "md:col-span-6",
  7: "md:col-span-7",
  8: "md:col-span-8",
  9: "md:col-span-9",
  12: "md:col-span-12",
};
const cls = spanClass[span] ?? "md:col-span-4";
---

<section class:list={["col-span-12", cls, "border border-graphite-700/60 rounded-md p-6"]}>
  <p class="mono-label mb-4">{label}</p>
  <slot />
</section>
