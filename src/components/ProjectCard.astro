---
import type { CollectionEntry } from "astro:content";
import PlaceholderHero from "./PlaceholderHero.astro";
import { getTagsForProject } from "../lib/categories";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

interface Props {
  project: CollectionEntry<"projects">;
  eager?: boolean;
}

function publicFileExists(webPath: string | null | undefined): boolean {
  if (!webPath || !webPath.startsWith("/")) return false;
  const url = new URL(`../../public${webPath}`, import.meta.url);
  return existsSync(fileURLToPath(url));
}

const { project, eager = false } = Astro.props;
const { data } = project;
const dataAny = data as any;

// Round-6: ALL cards are 4/3 horizontal — uniform grid across /work and
// /architecture. No more size variants (large/default/small were a Round-3
// hero-card treatment that broke visual rhythm).
const aspect = "aspect-[4/3]";

// Media resolution: gif_hero > video (local mp4) > hero_image > placeholder
// gif_hero renders as <img> (browsers loop GIFs natively)
const gifHero: string | undefined = dataAny.gif_hero;
const rawVideo: string | undefined = dataAny.video;
const localVideo: string | undefined =
  rawVideo && /\.(mp4|webm|mov)$/i.test(rawVideo) ? rawVideo : undefined;

// Round-5 Fix 1: when frontmatter explicitly sets `hero_image: null`, honor
// the null and let the designed PlaceholderHero render. Do NOT fall through
// to images[0] — projects without a canonical photo-quality hero deserve a
// designed editorial card, not a sprite or chart cropped at card aspect.
const heroExplicitlyNull = data.hero_image === null;
const heroImg = heroExplicitlyNull
  ? null
  : (data.hero_image || (data.images && data.images[0]) || null);
const heroIsImage = heroImg && !/\.(pdf|mp4|mov|webm)$/i.test(heroImg);
const heroExists = heroIsImage && publicFileExists(heroImg);
const gifExists = gifHero && publicFileExists(gifHero);
const videoExists = localVideo && publicFileExists(localVideo);

const slug = (project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, "");
const yearLabel = data.year ? String(data.year) : "";
// Round-6: every card's metadata row is YEAR · CONTEXT — same shape across
// /work and /architecture. CONTEXT is course_code (CMU coursework) →
// institution (architecture studios) → first category (fallback).
const contextBit =
  (data.course_code && String(data.course_code)) ||
  (dataAny.institution && String(dataAny.institution)) ||
  (data.categories && data.categories[0]) ||
  "";
const monoBits = [yearLabel, contextBit].filter(Boolean);
const tagPills: string[] = getTagsForProject(data);
---

<a
  href={`/work/${slug}`}
  class="card-surface group block"
>
  <div class:list={["relative overflow-hidden", aspect]} style="background: rgb(var(--surface-bg)); border-bottom: 1px solid rgb(var(--surface-border));">
    {gifExists ? (
      <img
        src={gifHero}
        alt={data.title}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        transition:name={`hero-${slug}`}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
      />
    ) : videoExists ? (
      <video
        src={localVideo}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={heroExists ? heroImg : undefined}
        transition:name={`hero-${slug}`}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
      />
    ) : heroExists ? (
      <img
        src={heroImg}
        alt={data.title}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        transition:name={`hero-${slug}`}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
      />
    ) : (
      <div transition:name={`hero-${slug}`} class="absolute inset-0">
        <PlaceholderHero slug={slug} title={data.title} categories={data.categories ?? []} size="card" />
      </div>
    )}

    {data.priority === "flagship" && (
      <span
        class="absolute top-3 right-3 block w-1.5 h-1.5 rounded-full"
        style="background: rgb(var(--accent-rgb));"
        aria-label="flagship project"
      />
    )}
  </div>

  <div class="p-5 md:p-6 flex flex-col gap-2.5">
    {/* Round-6 unified metadata layout (every card, every page):
          row 1: TAG pills — type identification
          row 2: title — display serif
          row 3: YEAR · CONTEXT — mono kicker (muted) */}
    {tagPills.length > 0 && (
      <div class="flex flex-wrap" style="gap: 6px;">
        {tagPills.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    <h3
      class="transition-colors duration-280 ease-out-soft group-hover:text-[rgb(var(--accent-rgb))]"
      style="font-family: theme(fontFamily.display); font-size: var(--step-2); font-weight: 380; line-height: 1.2; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
    >
      {data.title}
    </h3>
    {monoBits.length > 0 && (
      <div class="mono-label flex items-center gap-2" style="color: rgb(var(--text-muted));">
        {monoBits.map((bit, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{bit}</span>
          </>
        ))}
      </div>
    )}
  </div>
</a>
