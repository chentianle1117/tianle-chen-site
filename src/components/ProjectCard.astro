---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  size?: "default" | "large" | "small";
}

const { project, size = "default" } = Astro.props;
const { data } = project;

const sizeClass = {
  large: "md:col-span-2 md:row-span-2",
  default: "",
  small: "",
}[size];

const aspect = {
  large: "aspect-[16/10]",
  default: "aspect-[4/3]",
  small: "aspect-square",
}[size];

const hero = data.hero_image || (data.images && data.images[0]) || null;
const hrefSlug = data.slug;
---

<a
  href={`/work/${hrefSlug}`}
  class:list={["group block relative overflow-hidden rounded-xl bg-ink-900/50 border border-ink-800/50 transition-all duration-300 hover:border-accent/30 hover:shadow-2xl hover:shadow-accent/10", sizeClass]}
>
  {hero ? (
    <div class:list={["relative overflow-hidden bg-ink-900", aspect]}>
      <img
        src={hero}
        alt={data.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-ink-950/0 to-ink-950/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
    </div>
  ) : (
    <div class:list={["bg-ink-900 flex items-center justify-center", aspect]}>
      <span class="text-ink-500 font-mono text-xs">{data.slug}</span>
    </div>
  )}

  <div class="p-5 md:p-6 flex flex-col gap-3">
    <div class="flex items-center gap-3 text-xs font-mono uppercase tracking-widest text-ink-400">
      {data.year && <span>{data.year}</span>}
      {data.course_code && <span class="text-ink-600">·</span>}
      {data.course_code && <span>{String(data.course_code)}</span>}
      {data.priority === "flagship" && <span class="text-accent">· flagship</span>}
    </div>
    <h3 class="font-display text-xl md:text-2xl leading-tight text-ink-50 group-hover:text-accent transition-colors">
      {data.title}
    </h3>
    {data.categories && data.categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-1">
        {data.categories.slice(0, 3).map((cat: string) => (
          <span class="tag">{cat}</span>
        ))}
      </div>
    )}
  </div>
</a>
