---
import type { CollectionEntry } from "astro:content";
import PlaceholderHero from "./PlaceholderHero.astro";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

interface Props {
  project: CollectionEntry<"projects">;
  size?: "default" | "large" | "small";
  eager?: boolean;
}

function publicFileExists(webPath: string | null | undefined): boolean {
  if (!webPath || !webPath.startsWith("/")) return false;
  const url = new URL(`../../public${webPath}`, import.meta.url);
  return existsSync(fileURLToPath(url));
}

const { project, size = "default", eager = false } = Astro.props;
const { data } = project;
const dataAny = data as any;

const aspect = {
  large: "aspect-[16/10]",
  default: "aspect-[4/3]",
  small: "aspect-square",
}[size];

// Media resolution: gif_hero > video (local mp4) > hero_image > placeholder
// gif_hero renders as <img> (browsers loop GIFs natively)
const gifHero: string | undefined = dataAny.gif_hero;
const rawVideo: string | undefined = dataAny.video;
const localVideo: string | undefined =
  rawVideo && /\.(mp4|webm|mov)$/i.test(rawVideo) ? rawVideo : undefined;

const heroImg = data.hero_image || (data.images && data.images[0]) || null;
const heroIsImage = heroImg && !/\.(pdf|mp4|mov|webm)$/i.test(heroImg);
const heroExists = heroIsImage && publicFileExists(heroImg);
const gifExists = gifHero && publicFileExists(gifHero);
const videoExists = localVideo && publicFileExists(localVideo);

const slug = (project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, "");
const yearLabel = data.year ? String(data.year) : "";
const courseOrCat =
  (data.course_code && String(data.course_code)) ||
  (data.categories && data.categories[0]) ||
  "";
const monoBits = [yearLabel, courseOrCat].filter(Boolean);
const tags: string[] = (data.categories ?? []).slice(0, 3);
---

<a
  href={`/work/${slug}`}
  data-card-slug={slug}
  data-card-categories={(data.categories ?? []).join("|")}
  data-card-year={data.year ?? ""}
  data-card-priority={data.priority ?? "standard"}
  data-card-title={data.title}
  class="card-surface group block"
>
  <div class:list={["relative overflow-hidden", aspect]} style="background: rgb(var(--surface-bg)); border-bottom: 1px solid rgb(var(--surface-border));">
    {gifExists ? (
      <img
        src={gifHero}
        alt={data.title}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        transition:name={`hero-${slug}`}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
      />
    ) : videoExists ? (
      <video
        src={localVideo}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={heroExists ? heroImg : undefined}
        transition:name={`hero-${slug}`}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
      />
    ) : heroExists ? (
      <img
        src={heroImg}
        alt={data.title}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        transition:name={`hero-${slug}`}
        class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
      />
    ) : (
      <div transition:name={`hero-${slug}`} class="absolute inset-0">
        <PlaceholderHero slug={slug} title={data.title} categories={data.categories ?? []} size="card" />
      </div>
    )}

    {data.priority === "flagship" && (
      <span
        class="absolute top-3 right-3 block w-1.5 h-1.5 rounded-full"
        style="background: rgb(var(--accent-rgb));"
        aria-label="flagship project"
      />
    )}
  </div>

  <div class="p-5 md:p-6 flex flex-col gap-3">
    {monoBits.length > 0 && (
      <div class="mono-label flex items-center gap-2">
        {monoBits.map((bit, i) => (
          <>
            {i > 0 && <span aria-hidden="true" style="color: rgb(var(--text-muted));">·</span>}
            <span>{bit}</span>
          </>
        ))}
      </div>
    )}
    <h3
      class="transition-colors duration-280 ease-out-soft group-hover:text-[rgb(var(--accent-rgb))]"
      style="font-family: theme(fontFamily.display); font-size: var(--step-2); font-weight: 380; line-height: 1.2; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
    >
      {data.title}
    </h3>
    {tags.length > 0 && (
      <p
        class="font-mono"
        style="font-size: 11px; letter-spacing: 0.04em; color: rgb(var(--text-mono));"
      >
        {tags.map((c) => c.toLowerCase()).join(" · ")}
      </p>
    )}
  </div>
</a>
