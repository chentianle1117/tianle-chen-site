---
// ThemeToggle — small button in nav. Toggles `dark` / `light` class on <html>,
// persists to localStorage, and dispatches a `theme-change` event so JS islands
// (e.g. the latent-space hero) can react.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="theme-toggle inline-flex items-center justify-center w-9 h-9 rounded-md border border-subtle hover:border-strong text-secondary hover:text-accent-hi transition-all duration-280 ease-out-soft"
>
  {/* Sun — visible in dark mode (click to go light) */}
  <svg
    class="theme-icon theme-icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m4.93 4.93 1.41 1.41" />
    <path d="m17.66 17.66 1.41 1.41" />
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="m6.34 17.66-1.41 1.41" />
    <path d="m19.07 4.93-1.41 1.41" />
  </svg>

  {/* Moon — visible in light mode (click to go dark) */}
  <svg
    class="theme-icon theme-icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
</button>

<style>
  /* Show sun in dark mode, moon in light mode. Only one is visible. */
  .theme-icon { display: none; }
  :global(.dark) .theme-toggle .theme-icon-sun,
  :global([data-theme="dark"]) .theme-toggle .theme-icon-sun { display: block; }
  :global(.light) .theme-toggle .theme-icon-moon,
  :global([data-theme="light"]) .theme-toggle .theme-icon-moon { display: block; }
</style>

<script is:inline>
  (function () {
    function bind() {
      const btn = document.getElementById("theme-toggle");
      if (!btn || btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", function () {
        const root = document.documentElement;
        const cur = root.getAttribute("data-theme") ||
                    (root.classList.contains("dark") ? "dark" : "light");
        const next = cur === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        root.classList.toggle("dark", next === "dark");
        root.classList.toggle("light", next === "light");
        try { localStorage.setItem("theme", next); } catch (e) {}
        window.dispatchEvent(
          new CustomEvent("theme-change", { detail: { theme: next } })
        );
      });
    }
    bind();
    document.addEventListener("astro:page-load", bind);
  })();
</script>
