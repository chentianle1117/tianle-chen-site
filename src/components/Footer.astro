---
const buildDate = new Date().toISOString().slice(0, 10);

const primaryLinks = [
  { href: "/latent-space", label: "Latent Space" },
  { href: "/work", label: "Projects" },
  { href: "/labs", label: "Labs" },
  { href: "/architecture", label: "Architecture" },
  { href: "/thesis", label: "Thesis" },
  { href: "/about", label: "About" },
  { href: "/dashboard", label: "Dashboard" },
];

const secondaryLinks = [
  { href: "/davidchen-cv.pdf", label: "CV (PDF)", external: true },
  { href: "https://github.com/chentianle1117/tianle-chen-site", label: "Source", external: true },
  { href: "/rss.xml", label: "RSS", external: false },
];
---

<footer
  class="mt-32"
  style="border-top: 1px solid rgb(var(--surface-border));"
>
  <div class="container-display" style="padding-block: 4rem 2rem;">
    {/* Row 1 — identity + contact */}
    <div class="grid md:grid-cols-2 gap-8 md:gap-12">
      <div>
        <div
          class="font-mono"
          style="color: rgb(var(--text-secondary)); font-size: var(--step-0); line-height: 1.6;"
        >
          &copy; 2026 Tianle Chen &mdash; Portland &middot; Shanghai
        </div>
        <div
          class="font-mono mt-1"
          style="color: rgb(var(--text-muted)); font-size: var(--step--1); letter-spacing: 0.04em;"
        >
          Gen-AI engineer &middot; Computational designer
        </div>
      </div>

      <ul class="flex flex-col gap-2 md:items-end" aria-label="Contact">
        <li>
          <a
            href="https://www.linkedin.com/in/tianle-david-chen/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-contact-link"
          >
            <span>linkedin.com/in/tianle-david-chen</span>
            <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24ZM96,176a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm-8-88a12,12,0,1,1,12-12A12,12,0,0,1,88,88Zm96,88a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140Z" />
            </svg>
          </a>
        </li>
        <li class="flex items-center gap-2">
          <a
            href="mailto:tianlechen0324@gmail.com"
            class="footer-contact-link"
          >
            <span>tianlechen0324@gmail.com</span>
            <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05L203.84,192H52.16ZM157.29,128,216,74.18V181.82Z" />
            </svg>
          </a>
          <button
            type="button"
            class="footer-copy-btn"
            data-copy="tianlechen0324@gmail.com"
            aria-label="Copy email to clipboard"
            title="Copy email"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="1.5" />
              <path d="M5 15V5a1 1 0 0 1 1-1h10" />
            </svg>
            <span class="copy-feedback" aria-hidden="true">Copied</span>
          </button>
        </li>
        <li>
          <a
            href="https://github.com/chentianle1117"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-contact-link"
          >
            <span>github.com/chentianle1117</span>
            <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68Z" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    {/* Row 2 — secondary nav links */}
    <div
      class="grid md:grid-cols-2 gap-6 mt-12 pt-8"
      style="border-top: 1px solid rgb(var(--surface-border));"
    >
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer primary">
        {primaryLinks.map((link) => (
          <a href={link.href} class="footer-nav-link mono-label">{link.label}</a>
        ))}
      </nav>
      <nav class="flex flex-wrap gap-x-5 gap-y-2 md:justify-end" aria-label="Footer secondary">
        {secondaryLinks.map((link) => (
          <a
            href={link.href}
            class="footer-nav-link mono-label"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    {/* Row 3 — colophon */}
    <div
      class="mt-10 pt-6 font-mono text-center"
      style="border-top: 1px solid rgb(var(--surface-border) / 0.6); color: rgb(var(--text-muted)); font-size: var(--step--1); letter-spacing: 0.06em; text-transform: uppercase;"
    >
      Built with Astro &middot; Three.js &middot; OpenCLIP. Last published {buildDate}.
    </div>
  </div>
</footer>

<style>
  .footer-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: theme(fontFamily.mono);
    font-size: var(--step--1);
    color: rgb(var(--text-secondary));
    transition: color 200ms ease;
    text-decoration: none;
  }
  .footer-contact-link:hover {
    color: rgb(var(--accent-rgb));
  }

  .footer-copy-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 4px;
    background: transparent;
    border: 1px solid rgb(var(--surface-border));
    color: rgb(var(--text-muted));
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }
  .footer-copy-btn:hover {
    color: rgb(var(--accent-rgb));
    border-color: rgb(var(--accent-rgb) / 0.5);
  }
  .footer-copy-btn .copy-feedback {
    position: absolute;
    top: -1.6rem;
    right: 0;
    font-family: theme(fontFamily.mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--accent-rgb));
    opacity: 0;
    transition: opacity 200ms ease;
    pointer-events: none;
    white-space: nowrap;
  }
  .footer-copy-btn[data-copied="true"] .copy-feedback {
    opacity: 1;
  }

  .footer-nav-link {
    transition: color 200ms ease;
    text-decoration: none;
  }
  .footer-nav-link:hover {
    color: rgb(var(--accent-rgb));
  }
</style>

<script>
  const initFooterCopy = () => {
    document.querySelectorAll<HTMLButtonElement>(".footer-copy-btn").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const value = btn.dataset.copy || "";
        try {
          await navigator.clipboard.writeText(value);
          btn.dataset.copied = "true";
          window.setTimeout(() => {
            btn.dataset.copied = "false";
          }, 1600);
        } catch (e) {
          // fallback noop
        }
      });
    });
  };
  initFooterCopy();
  document.addEventListener("astro:page-load", initFooterCopy);
</script>
