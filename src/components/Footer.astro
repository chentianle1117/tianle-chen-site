---
const navLinks = [
  { href: "/work", label: "Work" },
  { href: "/thesis", label: "Thesis" },
  { href: "/architecture", label: "Architecture" },
  { href: "/about", label: "About" },
  { href: "/dashboard", label: "Dashboard" },
  { href: "/feed", label: "Feed" },
];
---

<footer class="border-t border-graphite-800/60 mt-32">
  <div class="container-page py-16 md:py-20 grid md:grid-cols-3 gap-12">
    {/* Left: identity */}
    <div class="font-mono text-graphite-300 text-sm leading-relaxed">
      <div>David Chen · 2026</div>
      <div class="text-graphite-400 mt-1">Pittsburgh, PA</div>
    </div>

    {/* Center: nav repeat */}
    <nav class="flex flex-wrap gap-x-5 gap-y-3 md:justify-center">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-mono uppercase tracking-[0.08em] text-graphite-300 hover:text-oxide-400 transition-all duration-280 ease-out-soft"
          style="font-size: var(--step--1)"
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* Right: contact (LinkedIn first) */}
    <ul class="flex flex-col gap-3 md:items-end">
      <li>
        <a
          href="https://www.linkedin.com/in/tianle-chen"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-mono text-graphite-100 hover:text-oxide-400 transition-all duration-280 ease-out-soft"
          style="font-size: var(--step-0)"
        >
          <span>linkedin.com/in/tianle-chen</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 256 256"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M216,24H40A16,16,0,0,0,24,40V216a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V40A16,16,0,0,0,216,24ZM96,176a8,8,0,0,1-16,0V112a8,8,0,0,1,16,0Zm-8-88a12,12,0,1,1,12-12A12,12,0,0,1,88,88Zm96,88a8,8,0,0,1-16,0V140a20,20,0,0,0-40,0v36a8,8,0,0,1-16,0V112a8,8,0,0,1,15.79-1.78A36,36,0,0,1,184,140Z"
            />
          </svg>
        </a>
      </li>
      <li>
        <a
          href="mailto:tianlechen0324@gmail.com"
          class="inline-flex items-center gap-2 font-mono text-graphite-300 hover:text-oxide-400 transition-all duration-280 ease-out-soft"
          style="font-size: var(--step-0)"
        >
          <span>tianlechen0324@gmail.com</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 256 256"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05L203.84,192H52.16ZM157.29,128,216,74.18V181.82Z"
