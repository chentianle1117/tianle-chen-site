---
interface Props {
  email: string;
}
const { email } = Astro.props;
---
<button
  type="button"
  class="copy-email inline-flex items-center gap-2 text-graphite-200 hover:text-oxide-400 transition-colors duration-180"
  data-email={email}
>
  <span class="font-mono">{email}</span>
  <span class="copy-email-icon inline-flex items-center" aria-hidden="true">
    <svg class="icon-clipboard" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="8" y="3" width="9" height="4" rx="1" />
      <path d="M9 7H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2" />
    </svg>
    <svg class="icon-check hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M5 12l5 5L20 7" />
    </svg>
  </span>
</button>

<script>
  function bind() {
    document.querySelectorAll<HTMLButtonElement>(".copy-email").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const email = btn.dataset.email || "";
        try {
          await navigator.clipboard.writeText(email);
          const cb = btn.querySelector<SVGElement>(".icon-clipboard");
          const ck = btn.querySelector<SVGElement>(".icon-check");
          if (cb && ck) {
            cb.classList.add("hidden");
            ck.classList.remove("hidden");
            setTimeout(() => {
              cb.classList.remove("hidden");
              ck.classList.add("hidden");
            }, 1200);
          }
        } catch {}
      });
    });
  }
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
