---
interface Props {
  categories: string[]; // surfaced filter buckets
  years: number[];
  total: number;
}
const { categories, years, total } = Astro.props;
const yearsSorted = [...years].sort((a, b) => b - a);
---
<div
  id="filter-bar"
  class="filter-bar-bg sticky top-[52px] md:top-[56px] z-30 w-full"
  style="height: 56px;"
>
  <div class="filter-chips container-page h-full flex items-center gap-6 overflow-x-auto">
    {/* Categories */}
    <div class="flex items-center gap-2" role="group" aria-label="Filter by category">
      <span class="mono-label hidden md:inline">Cat</span>
      {categories.map((cat) => (
        <button
          type="button"
          class="filter-cat mono-label px-2 py-1 border border-graphite-700/60 rounded-sm transition-colors duration-180 ease-out-soft hover:border-oxide-500/40 hover:text-[rgb(var(--accent-rgb))] aria-pressed:bg-oxide-500/15 aria-pressed:text-[rgb(var(--accent-rgb))] aria-pressed:border-oxide-500/40"
          data-cat={cat}
          aria-pressed="false"
        >{cat}</button>
      ))}
    </div>

    <span class="text-[rgb(var(--surface-border))] select-none">|</span>

    {/* Years */}
    <div class="flex items-center gap-2" role="group" aria-label="Filter by year">
      <span class="mono-label hidden md:inline">Year</span>
      {yearsSorted.map((y) => (
        <button
          type="button"
          class="filter-year mono-label px-2 py-1 border border-graphite-700/60 rounded-sm transition-colors duration-180 ease-out-soft hover:border-oxide-500/40 hover:text-[rgb(var(--accent-rgb))] aria-pressed:bg-oxide-500/15 aria-pressed:text-[rgb(var(--accent-rgb))] aria-pressed:border-oxide-500/40"
          data-year={y}
          aria-pressed="false"
        >{y}</button>
      ))}
    </div>

    <span class="text-[rgb(var(--surface-border))] select-none">|</span>

    {/* Sort */}
    <div class="flex items-center gap-2 ml-auto" role="group" aria-label="Sort">
      <span class="mono-label hidden md:inline">Sort</span>
      <button type="button" class="filter-sort mono-label px-2 py-1 border border-graphite-700/60 rounded-sm transition-colors duration-180 hover:border-oxide-500/40 hover:text-[rgb(var(--accent-rgb))] aria-pressed:bg-oxide-500/15 aria-pressed:text-[rgb(var(--accent-rgb))] aria-pressed:border-oxide-500/40" data-sort="featured" aria-pressed="true">Featured</button>
      <button type="button" class="filter-sort mono-label px-2 py-1 border border-graphite-700/60 rounded-sm transition-colors duration-180 hover:border-oxide-500/40 hover:text-[rgb(var(--accent-rgb))] aria-pressed:bg-oxide-500/15 aria-pressed:text-[rgb(var(--accent-rgb))] aria-pressed:border-oxide-500/40" data-sort="recent" aria-pressed="false">Recent</button>
      <button type="button" class="filter-sort mono-label px-2 py-1 border border-graphite-700/60 rounded-sm transition-colors duration-180 hover:border-oxide-500/40 hover:text-[rgb(var(--accent-rgb))] aria-pressed:bg-oxide-500/15 aria-pressed:text-[rgb(var(--accent-rgb))] aria-pressed:border-oxide-500/40" data-sort="az" aria-pressed="false">A–Z</button>

      <span class="mono-label text-graphite-500 ml-3 hidden sm:inline" data-count>{total}</span>
    </div>
  </div>
</div>

<script>
  // URL-synced filters. Reads ?cat=foo,bar&year=2025&sort=recent and
  // applies show/hide + reorders the work grid. Categories OR; years OR.
  function init() {
    const grid = document.querySelector<HTMLElement>("#work-grid");
    const empty = document.querySelector<HTMLElement>("#work-empty");
    const bar = document.querySelector<HTMLElement>("#filter-bar");
    const counter = document.querySelector<HTMLElement>("[data-count]");
    if (!grid || !bar) return;

    const params = new URLSearchParams(window.location.search);
    const state = {
      cats: new Set((params.get("cat") || "").split(",").filter(Boolean)),
      years: new Set((params.get("year") || "").split(",").filter(Boolean)),
      sort: params.get("sort") || "featured",
    };

    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-card-slug]"));

    function cardCats(card: HTMLElement): string[] {
      // Project categories are matched by FilterBar buckets via attribute lookup
      const buckets = card.getAttribute("data-card-buckets");
      return buckets ? buckets.split("|").filter(Boolean) : [];
    }

    // priority rank: flagship first, experimental last. Drives the default
    // "Featured" order so the highest-value work leads, not just the newest.
    const priRank = (p?: string) =>
      p === "flagship" ? 0 : p === "experimental" ? 2 : 1;

    function applySort() {
      const sorted = cards.slice();
      if (state.sort === "az") {
        sorted.sort((a, b) =>
          (a.dataset.cardTitle || "").localeCompare(b.dataset.cardTitle || "")
        );
      } else if (state.sort === "recent") {
        sorted.sort((a, b) => {
          const ay = parseInt(a.dataset.cardYear || "0", 10);
          const by = parseInt(b.dataset.cardYear || "0", 10);
          if (by !== ay) return by - ay;
          return priRank(a.dataset.cardPriority) - priRank(b.dataset.cardPriority);
        });
      } else {
        // featured (default): priority tier, then year desc within a tier.
        sorted.sort((a, b) => {
          const ra = priRank(a.dataset.cardPriority);
          const rb = priRank(b.dataset.cardPriority);
          if (ra !== rb) return ra - rb;
          const ay = parseInt(a.dataset.cardYear || "0", 10);
          const by = parseInt(b.dataset.cardYear || "0", 10);
          return by - ay;
        });
      }
      sorted.forEach((c) => grid.appendChild(c));
    }

    // Round-6: dropped applySpan() — uniform grid across breakpoints means
    // there's no "first card large" treatment to maintain. Tailwind classes
    // on the grid itself handle responsive columns.

    function applyFilters() {
      let visible = 0;
      cards.forEach((c) => {
        const cats = cardCats(c);
        const year = c.dataset.cardYear || "";
        const catOk =
          state.cats.size === 0 || cats.some((x) => state.cats.has(x));
        const yearOk = state.years.size === 0 || state.years.has(year);
        if (catOk && yearOk) {
          c.style.display = "";
          visible++;
        } else {
          c.style.display = "none";
        }
      });
      if (counter) counter.textContent = String(visible);
      if (empty) empty.style.display = visible === 0 ? "" : "none";
      grid.style.display = visible === 0 ? "none" : "";
    }

    function syncURL() {
      const next = new URLSearchParams();
      if (state.cats.size) next.set("cat", Array.from(state.cats).join(","));
      if (state.years.size) next.set("year", Array.from(state.years).join(","));
      if (state.sort && state.sort !== "featured") next.set("sort", state.sort);
      const qs = next.toString();
      const url = qs ? `?${qs}` : window.location.pathname;
      window.history.replaceState({}, "", url);
    }

    function paintButtons() {
      bar!.querySelectorAll<HTMLButtonElement>(".filter-cat").forEach((b) => {
        b.setAttribute("aria-pressed", state.cats.has(b.dataset.cat || "") ? "true" : "false");
      });
      bar!.querySelectorAll<HTMLButtonElement>(".filter-year").forEach((b) => {
        b.setAttribute("aria-pressed", state.years.has(b.dataset.year || "") ? "true" : "false");
      });
      bar!.querySelectorAll<HTMLButtonElement>(".filter-sort").forEach((b) => {
        b.setAttribute("aria-pressed", state.sort === b.dataset.sort ? "true" : "false");
      });
    }

    bar.querySelectorAll<HTMLButtonElement>(".filter-cat").forEach((b) => {
      b.addEventListener("click", () => {
        const v = b.dataset.cat || "";
        if (state.cats.has(v)) state.cats.delete(v);
        else state.cats.add(v);
        paintButtons();
        applyFilters();
        syncURL();
      });
    });
    bar.querySelectorAll<HTMLButtonElement>(".filter-year").forEach((b) => {
      b.addEventListener("click", () => {
        const v = b.dataset.year || "";
        if (state.years.has(v)) state.years.delete(v);
        else state.years.add(v);
        paintButtons();
        applyFilters();
        syncURL();
      });
    });
    bar.querySelectorAll<HTMLButtonElement>(".filter-sort").forEach((b) => {
      b.addEventListener("click", () => {
        state.sort = b.dataset.sort || "recent";
        paintButtons();
        applySort();
        applyFilters();
        syncURL();
      });
    });

    const reset = document.querySelector<HTMLButtonElement>("#filter-reset");
    reset?.addEventListener("click", () => {
      state.cats.clear();
      state.years.clear();
      state.sort = "recent";
      paintButtons();
      applySort();
      applyFilters();
      syncURL();
    });

    paintButtons();
    applySort();
    applyFilters();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  /* Mobile: switch from wrap to horizontal scroll with right-edge fade mask. */
  @media (max-width: 414px) {
    .filter-chips {
      overflow-x: auto;
      flex-wrap: nowrap;
      -webkit-mask-image: linear-gradient(to right, black 90%, transparent);
      mask-image: linear-gradient(to right, black 90%, transparent);
    }
  }
</style>
