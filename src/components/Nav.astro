---
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;

// Order per Phase 2 contract: Work, Architecture, Thesis, Dashboard, About
const links = [
  { href: "/work", label: "Work" },
  { href: "/architecture", label: "Architecture" },
  { href: "/thesis", label: "Thesis" },
  { href: "/dashboard", label: "Dashboard" },
  { href: "/about", label: "About" },
];

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-50 backdrop-blur-md transition-colors duration-280 ease-out-soft"
  style="background-color: rgb(var(--surface-bg) / 0.85); border-bottom: 1px solid rgb(var(--surface-border));"
>
  <div class="container-display flex items-center justify-between gap-4 site-header-row">
    {/* Logotype — left */}
    <a
      href="/"
      class="font-display tracking-tight transition-colors duration-280 ease-out-soft"
      style="font-size: var(--step-1); font-weight: 480; color: rgb(var(--text-primary));"
      aria-label="Tianle Chen — home"
    >
      Tianle Chen
    </a>

    {/* Center nav — desktop */}
    <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
      {links.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class="nav-link mono-label"
            data-active={active ? "true" : "false"}
            aria-current={active ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    {/* Right cluster — CV + theme toggle */}
    <div class="flex items-center gap-2">
      <a
        href="/davidchen-cv.pdf"
        target="_blank"
        rel="noopener"
        class="btn btn-ghost hidden sm:inline-flex"
        aria-label="Download CV (PDF)"
      >
        CV
      </a>
      <ThemeToggle />

      {/* Mobile menu disclosure */}
      <details class="relative md:hidden" id="mobile-nav">
        <summary
          class="list-none cursor-pointer p-2 -mr-2 transition-colors"
          style="color: rgb(var(--text-secondary));"
          aria-label="Toggle menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          >
            <line x1="4" y1="8" x2="20" y2="8" />
            <line x1="4" y1="16" x2="20" y2="16" />
          </svg>
        </summary>
        <div
          class="absolute right-0 top-full mt-3 w-56 py-2 shadow-xl"
          style="background: rgb(var(--surface-1-rgb)); border: 1px solid rgb(var(--surface-border)); border-radius: 6px;"
        >
          <ul class="flex flex-col">
            {links.map((link) => {
              const active = isActive(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    class="nav-link-mobile mono-label block px-5 py-3"
                    data-active={active ? "true" : "false"}
                    aria-current={active ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
            <li>
              <a
                href="/davidchen-cv.pdf"
                target="_blank"
                rel="noopener"
                class="nav-link-mobile mono-label block px-5 py-3 sm:hidden"
              >
                CV (PDF)
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header-row {
    height: 52px;
  }
  @media (min-width: 768px) {
    .site-header-row { height: 56px; }
  }

  .nav-link {
    position: relative;
    transition: color 200ms ease;
    padding-block: 0.25rem;
  }
  .nav-link:hover {
    color: rgb(var(--accent-rgb));
  }
  .nav-link[data-active="true"] {
    color: rgb(var(--accent-rgb));
  }
  .nav-link[data-active="true"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: rgb(var(--accent-rgb));
  }

  .nav-link-mobile {
    transition: color 200ms ease, background 200ms ease;
  }
  .nav-link-mobile:hover {
    color: rgb(var(--accent-rgb));
    background: rgb(var(--surface-2-rgb) / 0.5);
  }
  .nav-link-mobile[data-active="true"] {
    color: rgb(var(--accent-rgb));
  }
</style>
