---
import { getEntry } from "astro:content";
import MonoLabel from "./MonoLabel.astro";

let kicker = "Now · 2026-07";
let body =
  "AI/ML Engineer at HILOS Studio in Portland — building production computer-vision and ML systems for generative design tooling. Semantic Canvas (MSCD thesis) completed May 2026; adapting it into a CHI 2027 paper.";

try {
  const entry = await getEntry("site", "now");
  if (entry) {
    if (entry.data.date) kicker = `Now · ${entry.data.date}`;
    if (entry.data.body) body = entry.data.body;
  }
} catch (_e) {
  // fall back to defaults above
}
---

<div data-reveal class="grid md:grid-cols-[auto_1fr] gap-6 md:gap-12 items-baseline">
  <MonoLabel tone="secondary">{kicker}</MonoLabel>
  <p
    class="font-display text-graphite-100 max-w-reading"
    style="font-size: var(--step-1); font-weight: 380; line-height: 1.45;"
  >
    {body}
  </p>
</div>
