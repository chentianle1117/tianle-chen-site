---
// @ts-nocheck
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionBreak from "../components/SectionBreak.astro";
// Agent D's component — resolves at build time.
// @ts-ignore - intentional: HeroNavigator is being built by Agent D in parallel.
import HeroNavigator from "../components/hero/HeroNavigator";
import PlaceholderHero from "../components/PlaceholderHero.astro";
import { getEntry } from "astro:content";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { getProjectCounts, ARCHITECTURE_SLUGS } from "../lib/projectCounts";
import { projectCategoryBuckets } from "../lib/categories";

function publicFileExists(webPath) {
  if (!webPath || !webPath.startsWith("/")) return false;
  const url = new URL(`../../public${webPath}`, import.meta.url);
  return existsSync(fileURLToPath(url));
}

// Round-5 Fix 4: route counts through projectCounts.ts (single source of truth).
const { all: allProjects, work: workCollection, counts: pc, years: pcYears } = await getProjectCounts();
const architectureSlugs = ARCHITECTURE_SLUGS;

// Sort: flagships first, then by year desc
const work = workCollection
  .sort((a, b) => {
    if (a.data.priority === "flagship" && b.data.priority !== "flagship") return -1;
    if (b.data.priority === "flagship" && a.data.priority !== "flagship") return 1;
    return (b.data.year ?? 0) - (a.data.year ?? 0);
  });

// Round-7 Phase D: ALL published work projects on the home page (not a 6/10
// subset). The scatter is the visual nav; the compact list below is the
// categorical browse. Both surfaces show the same 10 projects.
const featured = work;
const totalCount = pc.work;
const workYearRange = `${pcYears.work.min}—${pcYears.work.max}`;

// Group projects by primary category for the compact list. Buckets mirror the
// 7-tag taxonomy from src/lib/categories.ts but are simplified for browse.
type GroupedRow = {
  slug: string;
  title: string;
  year: number | null;
  summary: string | null;
  buckets: string[];
};

const grouped: Record<string, GroupedRow[]> = {};
for (const p of work) {
  const d: any = p.data;
  const buckets = projectCategoryBuckets(d.categories ?? []);
  const primary = buckets[0] ?? "OTHER";
  const slug = (p as any).slug ?? d.slug ?? p.id?.replace(/\.md$/, "");
  const row: GroupedRow = {
    slug,
    title: d.title,
    year: d.year ?? null,
    summary: typeof d.summary === "string" ? d.summary : null,
    buckets,
  };
  if (!grouped[primary]) grouped[primary] = [];
  grouped[primary].push(row);
}
// Sort categories by a fixed display order; sort projects within by year desc.
// Bucket names mirror FILTER_CATEGORIES from src/lib/categories.ts.
const CATEGORY_ORDER = [
  "ML/AI",
  "Research",
  "Interaction",
  "Design",
  "OTHER",
];
const groupedRows = CATEGORY_ORDER.filter((c) => grouped[c] && grouped[c].length).map((c) => ({
  category: c.toUpperCase(),
  rows: grouped[c].sort((a, b) => (b.year ?? 0) - (a.year ?? 0)),
}));

// Thesis teaser data
const thesis: any = await getEntry("projects", "semantic-canvas");
const thesisData = thesis?.data ?? {};
const thesisLive = thesisData.live_url;
// Use a clean output image as the thesis poster (avoid UI screenshot for the homepage poster)
const thesisPoster =
  publicFileExists("/assets/semantic-canvas/output-nano-generated-shoe.png")
    ? "/assets/semantic-canvas/output-nano-generated-shoe.png"
    : thesisData.hero_image;
// Pull first ~350 chars from the thesis body content for a clean intro
const thesisBody: string = (thesis?.body ?? "") as string;
const thesisIntroRaw = thesisBody
  .replace(/^---[\s\S]*?---/, "")
  .replace(/^#.*$/gm, "")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[\[([^\]|]+)(\|[^\]]+)?\]\]/g, "")
  .replace(/`[^`]+`/g, "")
  .replace(/\*\*([^*]+)\*\*/g, "$1")
  .replace(/\*([^*]+)\*/g, "$1")
  .replace(/\s+/g, " ")
  .trim();
const thesisIntro = thesisIntroRaw.slice(0, 380);

// Architecture rail
const archProjects = ["fiber-based-pavilion", "membrane-form-finding", "generative-urbanism", "wire-bending"]
  .map((s) => allProjects.find((p) => ((p as any).slug ?? p.data.slug) === s))
  .filter(Boolean);
---

<BaseLayout
  title="David Chen"
  description="Gen-AI engineer & computational designer. CMU MSCD thesis tools, generative 3D, design-AI integration."
>
  {/* ============ HERO — intro prologue + latent-space navigator ============ */}
  <section class="relative zone-base" style="border-bottom: 1px solid rgb(var(--surface-border));">
    {/* Variant C — Title-First, Hero-Second: prologue intro above the scatter.
        Round-5 Fix 6: at >=1280, render an editorial right-hand counterweight
        (mono index of axis options + scroll affordance) so the wide-viewport
        budget is used. The intro stays anchored left; the right column is
        secondary teaching/affordance that signals "scroll to explore". */}
    <div class="container-display pt-10 md:pt-14 pb-6 md:pb-8 home-intro-grid">
      <div class="home-intro-copy">
        <p class="mono-label" style="color: rgb(var(--text-mono));">
          PITTSBURGH ↔ SHANGHAI · CMU MSCD '26 → HILOS STUDIO
        </p>
        <h1
          class="mt-3"
          style="font-family: theme(fontFamily.display); font-size: var(--step-3); font-weight: 380; line-height: 1.15; letter-spacing: -0.005em; color: rgb(var(--text-primary));"
        >
          Tianle Chen <span style="opacity: 0.45; letter-spacing: 0;">陳天樂</span> — Gen AI / ML Engineer.
        </h1>
        <p
          style="font-family: theme(fontFamily.sans); font-size: var(--step-0); font-weight: 350; line-height: 1.55; color: rgb(var(--text-secondary)); max-width: 56ch; margin-top: 0.85rem;"
        >
          Vision-based AI tools at the seam of generative ML and the design process. Hover any tile in the scatter below to read its summary; click to open the case study.
        </p>
      </div>

      {/* Right counterweight — only shown >=1280. Reads as an editorial
          legend / table-of-contents for the scatter below. */}
      <aside class="home-intro-aside" aria-hidden="true">
        <p class="mono-label" style="color: rgb(var(--text-mono)); margin-bottom: 0.75rem;">↓ EXPLORE</p>
        <ul style="list-style: none; padding: 0; margin: 0; font-family: theme(fontFamily.mono); font-size: var(--step--1); line-height: 1.85; color: rgb(var(--text-secondary)); letter-spacing: 0.06em;">
          <li><span style="color: rgb(var(--text-mono));">01 ·</span> THESIS · UMAP · PCA · METADATA</li>
          <li><span style="color: rgb(var(--text-mono));">02 ·</span> X / Y AXIS · TYPE TO REMAP</li>
          <li><span style="color: rgb(var(--text-mono));">03 ·</span> CLICK TILE · OPEN PROJECT</li>
          <li><span style="color: rgb(var(--text-mono));">04 ·</span> {String(pc.work).padStart(2, "0")} WORK · {String(pc.arch).padStart(2, "0")} ARCH · {workYearRange}</li>
        </ul>
        <p style="font-family: theme(fontFamily.mono); font-size: var(--step--1); margin-top: 1.25rem; color: rgb(var(--text-mono)); letter-spacing: 0.10em;">
          <span aria-hidden="true">↓</span> SCROLL TO THE SCATTER
        </p>
      </aside>
    </div>
    <div class="mb-6 md:mb-8"></div>
    <HeroNavigator client:visible />
    <style>
      .home-intro-grid {
        display: block;
      }
      .home-intro-aside { display: none; }
      @media (min-width: 1280px) {
        .home-intro-grid {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(280px, 24rem);
          gap: 4rem;
          align-items: start;
        }
        .home-intro-aside {
          display: block;
          padding-top: 0.5rem;
          border-left: 1px solid rgb(var(--surface-border));
          padding-left: 2rem;
        }
      }
    </style>
  </section>

  {/* ============ SELECTED WORK ============ */}
  <section class="zone-raised">
    <SectionBreak number="01" label="SELECTED WORK" />

    <div class="container-display py-12" aria-labelledby="selected-work">
    <div class="flex items-baseline justify-between flex-wrap gap-4 mb-8">
      <h2
        id="selected-work"
        style="font-family: theme(fontFamily.display); font-size: var(--step-4); font-weight: 380; line-height: 1.05; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
      >
        Selected work
      </h2>
      <p class="mono-label">
        {String(featured.length).padStart(2, "0")} of {String(totalCount).padStart(2, "0")} · {workYearRange}
      </p>
    </div>

    {/* Round-7 Phase D: compact category-grouped list. Replaces the 6-card
        asymmetric grid that duplicated what's already in the scatter above.
        Now the same 10 projects appear in both surfaces — scatter for visual
        latent-space browse, list for categorical scan. */}
    <div class="compact-work-list" data-stagger>
      {groupedRows.map(({ category, rows }) => (
        <section class="compact-cat-group">
          <header class="compact-cat-header">
            <span class="mono-label" style="color: rgb(var(--text-mono));">{category}</span>
            <span class="mono-label" style="color: rgb(var(--text-muted)); margin-left: 0.5rem;">{String(rows.length).padStart(2, "0")}</span>
          </header>
          <ul class="compact-row-list">
            {rows.map((row) => (
              <li>
                <a href={`/work/${row.slug}`} class="compact-row" data-reveal>
                  <span class="compact-row-title">{row.title}</span>
                  <span class="compact-row-summary">{row.summary ?? ""}</span>
                  <span class="compact-row-year mono-label">{row.year ?? ""}</span>
                  <span class="compact-row-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="mt-10 md:mt-14 flex justify-end">
      <a href="/work" class="btn-ghost mono-label" style="display: inline-flex; align-items: center; gap: 0.5rem;">
        View all {totalCount} projects in grid view
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <style>
      .compact-work-list {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
      }
      .compact-cat-group {
        border-top: 1px solid rgb(var(--surface-border));
        padding-top: 1rem;
      }
      .compact-cat-header {
        display: flex;
        align-items: baseline;
        margin-bottom: 0.5rem;
      }
      .compact-row-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .compact-row {
        display: grid;
        grid-template-columns: minmax(180px, 22ch) 1fr 5ch 2ch;
        align-items: baseline;
        gap: 1rem;
        padding: 0.65rem 0;
        text-decoration: none;
        color: rgb(var(--text-primary));
        border-bottom: 1px solid rgb(var(--surface-border) / 0.4);
        transition: background-color 220ms cubic-bezier(0.22, 1, 0.36, 1), border-color 220ms;
      }
      .compact-row:hover,
      .compact-row:focus-visible {
        background: rgb(var(--accent-rgb) / 0.08);
        border-bottom-color: rgb(var(--accent-rgb) / 0.5);
        outline: none;
      }
      .compact-row:hover .compact-row-arrow {
        color: rgb(var(--accent-rgb));
        transform: translateX(2px);
      }
      .compact-row-title {
        font-family: theme(fontFamily.display);
        font-size: var(--step-1);
        font-weight: 380;
        line-height: 1.2;
        letter-spacing: -0.005em;
      }
      .compact-row-summary {
        font-family: theme(fontFamily.sans);
        font-size: var(--step--1);
        line-height: 1.5;
        color: rgb(var(--text-secondary));
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
      }
      .compact-row-year {
        color: rgb(var(--text-mono));
      }
      .compact-row-arrow {
        color: rgb(var(--text-muted));
        transition: color 220ms, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
        text-align: right;
      }
      @media (max-width: 720px) {
        .compact-row {
          grid-template-columns: 1fr 5ch 2ch;
          row-gap: 0.25rem;
        }
        .compact-row-title { grid-column: 1 / 4; }
        .compact-row-summary { grid-column: 1 / 4; }
      }
    </style>
    </div>
  </section>

  {/* ============ THESIS ============ */}
  <section class="zone-base">
    <SectionBreak number="02" label="THESIS" />

    <div class="container-display pb-4" aria-labelledby="thesis-teaser">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
      {/* Poster */}
      <div class="md:col-span-7" data-reveal>
        <a
          href="/thesis"
          class="block overflow-hidden group"
          style="border: 1px solid rgb(var(--surface-border)); border-radius: 6px; background: rgb(var(--surface-1-rgb));"
        >
          <div class="relative aspect-[4/5] overflow-hidden">
            {thesisPoster && publicFileExists(thesisPoster) ? (
              <img
                src={thesisPoster}
                alt="Semantic Canvas — thesis poster"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
              />
            ) : (
              <PlaceholderHero
                slug="semantic-canvas"
                title="Semantic Canvas"
                categories={thesisData.categories ?? ["Thesis"]}
                size="hero"
              />
            )}
          </div>
        </a>
      </div>

      {/* Copy */}
      <div class="md:col-span-5 md:pt-4" data-reveal>
        <p class="mono-label mb-3">CMU MSCD · 2025—2026</p>
        <h2
          id="thesis-teaser"
          class="mb-5"
          style="font-family: theme(fontFamily.display); font-size: var(--step-3); font-weight: 380; line-height: 1.1; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
        >
          Semantic Canvas
        </h2>
        <p class="mb-4" style="color: rgb(var(--text-secondary)); line-height: 1.6;">
          A latent-space design instrument: type two words — <em>casual</em>, <em>formal</em> — and a shoe library rearranges itself by meaning. Drop in an image and it finds its place. Generate variants in-place. A passive Gemini observer reads the brief and offers insights without interrupting.
        </p>
        <p class="mb-8" style="color: rgb(var(--text-secondary)); line-height: 1.6;">
          The thesis claim: a designer's <em>own words</em> are a better basis for navigating generative possibility space than the mathematical artifacts of t-SNE or UMAP. The site you are reading is itself a smaller version of the method.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/thesis" class="btn">Read full writeup</a>
          {thesisLive && (
            <a href={thesisLive} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Try the live tool
            </a>
          )}
        </div>
      </div>
    </div>
    </div>
  </section>

  {/* ============ ARCHITECTURE ============ */}
  <section class="zone-raised">
    <SectionBreak number="03" label="ARCHITECTURE" />

    <div class="container-display pb-4" aria-labelledby="architecture-rail">
    <div class="flex items-baseline justify-between flex-wrap gap-4 mb-8 md:mb-10">
      <h2
        id="architecture-rail"
        style="font-family: theme(fontFamily.display); font-size: var(--step-4); font-weight: 380; line-height: 1.05; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
      >
        Architecture
      </h2>
      <p class="mono-label">RICE UNIVERSITY · 2021—2024</p>
    </div>

    {/* Horizontal rail of 4 architecture cards */}
    <div
      class="flex gap-4 md:gap-6 overflow-x-auto pb-4 -mx-6 px-6 md:-mx-12 md:px-12 snap-x snap-mandatory"
      data-stagger
      style="scrollbar-width: thin;"
    >
      {archProjects.map((p) => {
        const d: any = p.data;
        const heroSrc = d.gif_hero || d.hero_image || (d.images && d.images[0]) || null;
        const heroOk = heroSrc && publicFileExists(heroSrc);
        const slug = (p as any).slug ?? d.slug;
        return (
          <a
            href={`/work/${slug}`}
            class="group flex-shrink-0 snap-start block"
            style="width: 320px;"
            data-reveal
          >
            <div
              class="relative aspect-[3/4] overflow-hidden"
              style="border: 1px solid rgb(var(--surface-border)); border-radius: 6px; background: rgb(var(--surface-1-rgb));"
            >
              {heroOk ? (
                <img
                  src={heroSrc}
                  alt={d.title}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover transition-all duration-420 ease-out-soft group-hover:scale-[1.02] group-hover:brightness-[1.05]"
                />
              ) : (
                <PlaceholderHero slug={slug} title={d.title} categories={d.categories ?? []} size="hero" />
              )}
            </div>
            <div class="mt-3">
              <p class="mono-label mb-1">{d.year} · {d.role || (d.categories && d.categories[0]) || ""}</p>
              <h3
                style="font-family: theme(fontFamily.display); font-size: var(--step-2); font-weight: 380; line-height: 1.2; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
                class="group-hover:text-[rgb(var(--accent-rgb))] transition-colors duration-280"
              >
                {d.title}
              </h3>
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-8 md:mt-12 flex justify-end">
      <a href="/architecture" class="btn-ghost mono-label" style="display: inline-flex; align-items: center; gap: 0.5rem;">
        View all architecture
        <span aria-hidden="true">→</span>
      </a>
    </div>
    </div>
  </section>

  {/* ============ ABOUT TEASER ============ */}
  <section class="zone-base">
    <SectionBreak number="04" label="ABOUT" />

    <div class="container-reading pb-24 md:pb-32" aria-labelledby="about-teaser">
    <p class="mono-label mb-5">PITTSBURGH · 2026</p>
    <h2
      id="about-teaser"
      class="mb-6"
      style="font-family: theme(fontFamily.display); font-size: var(--step-3); font-weight: 380; line-height: 1.1; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
    >
      Designer turned engineer.
    </h2>
    <p class="mb-5" style="color: rgb(var(--text-secondary)); line-height: 1.65;">
      I am finishing an MSCD thesis at Carnegie Mellon — Semantic Canvas, an interactive latent-space tool for AI-augmented footwear design. Concurrently I work as an ML/AI engineer at HILOS Studio, shipping production tools that translate computer vision and generative models into the daily workflow of footwear designers.
    </p>
    <p class="mb-8" style="color: rgb(var(--text-secondary)); line-height: 1.65;">
      Before CMU, I trained as an architect at Rice — parametric form-finding, ceramic hollow columns published at IASS 2024, and four years of studio work across NBBJ Los Angeles, EID, Pure Architect, and ECADI. Architecture taught me to design for systems, not screens; ML lets me build them.
    </p>
    <a href="/about" class="btn-ghost mono-label" style="display: inline-flex; align-items: center; gap: 0.5rem;">
      Read more
      <span aria-hidden="true">→</span>
    </a>
    </div>
  </section>
</BaseLayout>
