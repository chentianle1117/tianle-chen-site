---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import IndexList from "../components/IndexList.astro";
import NowStrip from "../components/NowStrip.astro";
import MonoLabel from "../components/MonoLabel.astro";
import Reveal from "../components/Reveal.astro";
// Agent D's component — may not yet exist at the time of authoring; resolves at build time.
// @ts-ignore - intentional: HeroNavigator is being built by Agent D in parallel.
import HeroNavigator from "../components/hero/HeroNavigator";
import { getCollection } from "astro:content";

const allProjects = await getCollection(
  "projects",
  ({ data }) => data.publish === true
);
const sortedAll = [...allProjects].sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);
const flagships = sortedAll.filter((p) => p.data.priority === "flagship");
const featured = flagships.slice(0, 5); // 6th tile reserved for the "view all" CTA
const totalCount = sortedAll.length;
const totalLabel = String(totalCount).padStart(2, "0");
---

<BaseLayout
  title="David Chen"
  description="Gen-AI engineer & computational designer. CMU MSCD thesis tools, generative 3D, design-AI integration."
>
  {/* 1. Identity strip */}
  <section class="container-page pt-16">
    <div data-stagger class="flex flex-col items-center text-center">
      <Reveal>
        <MonoLabel tone="secondary">
          David Chen · Gen-AI engineer & computational designer · Pittsburgh, PA
        </MonoLabel>
      </Reveal>
      <Reveal>
        <div class="w-[240px] h-px bg-graphite-700 my-6" aria-hidden="true"></div>
      </Reveal>
    </div>
  </section>

  {/* 2. Latent navigator hero */}
  <section class="container-wide" data-stagger>
    <Reveal>
      <div
        class="relative aspect-[16/10] md:h-[78vh] md:min-h-[640px] md:aspect-auto rounded-md overflow-hidden border border-graphite-700/60"
      >
        <HeroNavigator client:visible />
      </div>
    </Reveal>
    <Reveal>
      <div class="mt-4 flex justify-center">
        <MonoLabel tone="tertiary">
          Interactive: drag to orbit · click a project · toggle layouts ↗
        </MonoLabel>
      </div>
    </Reveal>
  </section>

  {/* 3. Selected work */}
  <section class="container-page py-22 md:py-30" data-stagger aria-labelledby="selected-work">
    <Reveal>
      <MonoLabel tone="secondary" class="block mb-4">
        2022—2026 · 06 OF {totalLabel}
      </MonoLabel>
    </Reveal>
    <Reveal>
      <h2 id="selected-work" class="font-display mb-10 md:mb-14">Selected work</h2>
    </Reveal>

    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 snap-x snap-mandatory md:snap-none overflow-x-auto md:overflow-visible -mx-6 px-6 md:mx-0 md:px-0"
    >
      {featured.map((project) => (
        <Reveal class="snap-center md:snap-align-none min-w-[80%] md:min-w-0">
          <ProjectCard project={project} size="default" />
        </Reveal>
      ))}

      {/* 6th tile: View-all CTA, matches card-surface dimensions */}
      <Reveal class="snap-center md:snap-align-none min-w-[80%] md:min-w-0">
        <a
          href="/work"
          class="card-surface group flex flex-col h-full"
          aria-label="View all projects"
        >
          <div
            class="relative aspect-[4/3] flex flex-col items-center justify-center gap-3 bg-graphite-900 border-b border-graphite-700/60 transition-all duration-280 ease-out-soft group-hover:bg-graphite-800/80"
          >
            <span
              class="font-mono uppercase tracking-[0.08em] text-graphite-400 group-hover:text-oxide-400 transition-colors"
              style="font-size: var(--step--1)"
            >
              View all
            </span>
            <span
              class="font-display text-graphite-100 group-hover:text-oxide-400 transition-colors"
              style="font-size: var(--step-2); font-weight: 380;"
            >
              {totalCount} projects →
            </span>
          </div>
          <div class="p-5 md:p-6 flex flex-col gap-3">
            <div class="mono-label">Index</div>
            <h3
              class="font-display text-graphite-50 leading-tight"
              style="font-size: var(--step-2); font-weight: 380;"
            >
              All work
            </h3>
          </div>
        </a>
      </Reveal>
    </div>
  </section>

  {/* 4. Now strip */}
  <section class="container-page py-18 md:py-22 border-t border-graphite-800/50" data-stagger>
    <NowStrip />
  </section>

  {/* 5. Index list */}
  <section
    class="container-page py-22 md:py-30 border-t border-graphite-800/50"
    data-stagger
    aria-labelledby="all-work"
  >
    <Reveal>
      <MonoLabel tone="secondary" class="block mb-4">
        Index · {totalLabel} entries
      </MonoLabel>
    </Reveal>
    <Reveal>
      <h2 id="all-work" class="font-display mb-10 md:mb-14">All work</h2>
    </Reveal>
    <IndexList projects={sortedAll} />
  </section>
</BaseLayout>
