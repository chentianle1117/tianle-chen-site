---
// @ts-nocheck
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionBreak from "../components/SectionBreak.astro";
import StatStrip from "../components/StatStrip.astro";
// @ts-ignore - LatentAtlas is a React island (client:only)
import LatentAtlas from "../components/latent-atlas/LatentAtlas";

const description =
  "Type a semantic axis — warm ↔ cool, dense ↔ sparse, angular ↔ round — and watch 160 procedurally generated posters re-sort through CLIP's joint image-text space. No training: an axis is just a text-pole subtraction, and each tile's position is a single dot product.";

// Scannable metrics for the hero StatStrip. The accent lands on the first
// cell (per StatStrip.astro), so "0 models trained" carries the thesis punch.
const stats = [
  { value: "0", label: "models trained or fine-tuned" },
  { value: "160", label: "posters embedded offline, once" },
  { value: "512-d", label: "shared image + text space" },
  { value: "1", label: "dot product places each tile" },
];

// Page-level structured data — an interactive CreativeWork extending the
// technique from the owner's public master's thesis on semantic latent-space
// navigation. Kept generic (technique, not employer/product).
const creativeWork = {
  "@type": "CreativeWork",
  "@id": new URL("/latent-atlas#work", Astro.site).toString(),
  name: "Latent Atlas",
  headline: "Latent Atlas — navigate CLIP space by meaning",
  description,
  creator: { "@id": new URL("/#person", Astro.site).toString() },
  keywords: [
    "CLIP",
    "latent space",
    "semantic axes",
    "joint image-text embeddings",
    "interactive data visualization",
    "dot-product projection",
  ],
  about: "Interactive navigation of CLIP joint image-text embedding space.",
};
---

<BaseLayout
  title="Latent Atlas — navigate CLIP space by meaning"
  description={description}
  structuredData={creativeWork}
>
  {/* ── Hero / thesis ──────────────────────────────────────────────── */}
  <section class="zone-base">
    <div class="container-display pt-10 md:pt-16 pb-12 md:pb-16">
      <p class="mono-label" style="color: rgb(var(--text-mono));">
        INTERACTIVE · CLIP JOINT SPACE · 160 GENERATED POSTERS · NO TRAINING
      </p>
      <h1 class="mt-4 h1-fluid" style="max-width: 18ch;">
        Latent Atlas.
      </h1>
      <p
        class="mt-5"
        style="font-family: theme(fontFamily.sans); font-size: var(--step-1); font-weight: 350; line-height: 1.5; color: rgb(var(--text-secondary)); max-width: 62ch;"
      >
        Describe a dimension in your own words — <strong style="color: rgb(var(--text-primary)); font-weight: 500;">warm&nbsp;↔&nbsp;cool, dense&nbsp;↔&nbsp;sparse, angular&nbsp;↔&nbsp;round</strong> — and 160 images re-sort by meaning in real time.
        <strong style="color: rgb(var(--text-primary)); font-weight: 500;">Nothing is trained; the whole move is a text prompt and a dot product.</strong>
      </p>

      <StatStrip stats={stats} />
    </div>
  </section>

  {/* ── The instrument ─────────────────────────────────────────────── */}
  <section class="zone-base">
    <SectionBreak number="01" label="THE INSTRUMENT" />
    <div class="container-display pb-4">
      <p
        class="container-reading mx-0 px-0 mb-6"
        style="max-width: 68ch; color: rgb(var(--text-secondary)); line-height: 1.65;"
      >
        Try it first. Pick a preset axis or type your own two poles, then watch the
        field re-form. Drag to pan, scroll to zoom, hover any tile to inspect its
        score. The first axis loads CLIP&apos;s text encoder into your browser once;
        everything after is instant.
      </p>
      <LatentAtlas client:only="react" />
    </div>
  </section>

  {/* ── Why it matters — problem framing + the insight spine ───────── */}
  <section class="zone-raised">
    <SectionBreak number="02" label="WHY IT MATTERS" />
    <div class="container-display pb-14 md:pb-20">
      <div class="why-grid grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        <div class="why-col">
          <p class="mono-label mb-3">THE PROBLEM</p>
          <p>
            Every image library is searchable only by the tags someone defined in
            advance. Ask for a dimension nobody labeled — <em>warmer</em>,
            <em>busier</em>, <em>more playful</em> — and you are stuck training a
            classifier or hand-sorting by eye. <strong>Open-ended visual dimensions
            have no cheap handle.</strong>
          </p>
        </div>
        <div class="why-col why-col--insight">
          <p class="mono-label mb-3" style="color: rgb(var(--accent-rgb));">
            THE INSIGHT
          </p>
          <p>
            <strong>Semantic axes need no training.</strong> Because CLIP aligns
            image and text in one space, <strong>warm-vs-cool is literally the
            vector between the two words</strong> — and projecting images onto it
            sorts them by meaning. The axis is a subtraction; the position is a dot
            product.
          </p>
        </div>
        <div class="why-col">
          <p class="mono-label mb-3">WHO IT&apos;S FOR</p>
          <p>
            Anyone with a pile of images and a word for what they want: a photo
            library, a moodboard, product shots, a design archive. <strong>Invent
            the axis on the spot, in plain language</strong> — no taxonomy to
            maintain, no model to retrain. It generalizes the thesis idea to any
            collection.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── How it works — prose + teaching diagram ────────────────────── */}
  <section class="zone-base">
    <SectionBreak number="03" label="HOW IT WORKS" />
    <div class="container-reading prose-custom pb-4">
      <h2 style="margin-top: 0;">One space for images and words</h2>
      <p>
        CLIP was trained on hundreds of millions of image–caption pairs with a
        single objective: <strong>pull matching image and text together in one
        vector space, and push mismatched pairs apart.</strong> The consequence we
        lean on here is quiet but radical — a warm-toned poster and the phrase
        <em>&ldquo;a warm colored image&rdquo;</em> land near each other, even though
        one is pixels and the other is language. <strong>Images and words become
        directly comparable coordinates in the same 512 dimensions.</strong>
      </p>
      <p>
        Every poster here was embedded once, offline, with CLIP&apos;s
        <em>image</em> encoder. The map you first land on is a plain PCA of those
        vectors — the two directions of greatest variance, with <strong>no labels
        and no training.</strong> It already clusters by look, because CLIP&apos;s
        space is organized by appearance and meaning.
      </p>
    </div>

    {/* ── The mechanism, in one figure ─────────────────────────────── */}
    <div class="container-display">
      <figure class="diagram la-diagram">
        <svg
          viewBox="0 0 1180 620"
          role="img"
          aria-labelledby="la-diagram-title la-diagram-desc"
          style="width: 100%; height: auto; color: rgb(var(--text-secondary));"
          xmlns="http://www.w3.org/2000/svg"
          font-family="'IBM Plex Mono', ui-monospace, Menlo, monospace"
        >
          <title id="la-diagram-title">
            The CLIP mechanism behind Latent Atlas
          </title>
          <desc id="la-diagram-desc">
            An image encoder and a text encoder map into one shared 512-dimensional
            space. A semantic axis is the normalized difference between two text-pole
            embeddings. An image's position is the dot product of its embedding with
            that axis. No training is involved.
          </desc>

          <defs>
            <marker id="la-arw" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
              <path d="M0,0 L8,4.5 L0,9 Z" fill="currentColor" opacity="0.55" />
            </marker>
          </defs>

          {/* title */}
          <text x="40" y="46" fill="rgb(var(--accent-rgb))" font-size="16" letter-spacing="3">THE MECHANISM</text>
          <text x="40" y="72" fill="currentColor" opacity="0.55" font-size="13">Two encoders → one space → an axis is a subtraction, a position is a dot product</text>

          {/* ── inputs ── */}
          {/* image (stacked to imply a set) */}
          <rect x="40" y="120" width="70" height="70" rx="6" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.25" />
          <rect x="50" y="130" width="70" height="70" rx="6" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.4" />
          <rect x="60" y="140" width="70" height="70" rx="6" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.7" />
          <text x="95" y="228" text-anchor="middle" fill="currentColor" font-size="12">a poster (pixels)</text>

          {/* text poles */}
          <rect x="30" y="298" width="150" height="66" rx="6" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
          <text x="105" y="328" text-anchor="middle" fill="currentColor" font-size="14">&ldquo;warm&rdquo;  ·  &ldquo;cool&rdquo;</text>
          <text x="105" y="348" text-anchor="middle" fill="currentColor" opacity="0.55" font-size="10.5">two words you type</text>

          {/* ── encoders ── */}
          <rect x="230" y="135" width="170" height="72" rx="7" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
          <text x="315" y="168" text-anchor="middle" fill="currentColor" font-size="13.5">IMAGE ENCODER</text>
          <text x="315" y="188" text-anchor="middle" fill="currentColor" opacity="0.5" font-size="10">pretrained · frozen</text>

          <rect x="230" y="296" width="170" height="72" rx="7" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
          <text x="315" y="329" text-anchor="middle" fill="currentColor" font-size="13.5">TEXT ENCODER</text>
          <text x="315" y="349" text-anchor="middle" fill="currentColor" opacity="0.5" font-size="10">pretrained · frozen</text>

          {/* input → encoder arrows */}
          <g fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.6">
            <path d="M130,175 L224,171" marker-end="url(#la-arw)" />
            <path d="M182,331 L224,332" marker-end="url(#la-arw)" />
          </g>

          {/* encoder → shared-space arrows (converging = one space) */}
          <g fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.6">
            <path d="M402,171 L452,203" marker-end="url(#la-arw)" />
            <path d="M402,332 L452,300" marker-end="url(#la-arw)" />
          </g>

          {/* ── the shared space (the crux) ── */}
          <rect x="460" y="120" width="280" height="250" rx="8" fill="rgb(var(--accent-rgb) / 0.05)" stroke="currentColor" stroke-opacity="0.55" />
          <text x="600" y="148" text-anchor="middle" fill="rgb(var(--accent-rgb))" font-size="12.5" letter-spacing="1.5">ONE SHARED 512-D SPACE</text>

          {/* axis (dashed) between the two text poles */}
          <path d="M510,329 L700,178" stroke="rgb(var(--accent-rgb))" stroke-opacity="0.7" stroke-width="1.5" stroke-dasharray="5 4" fill="none" />
          {/* poles */}
          <circle cx="520" cy="320" r="5" fill="currentColor" opacity="0.65" />
          <text x="512" y="338" text-anchor="end" fill="currentColor" opacity="0.7" font-size="10.5">cool</text>
          <circle cx="690" cy="185" r="5" fill="rgb(var(--accent-rgb))" />
          <text x="700" y="180" text-anchor="start" fill="rgb(var(--accent-rgb))" font-size="10.5">warm</text>
          {/* image point + its projection foot */}
          <line x1="575" y1="225" x2="600" y2="256" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.2" stroke-dasharray="3 3" />
          <circle cx="600" cy="256" r="3.5" fill="none" stroke="rgb(var(--accent-rgb))" stroke-width="1.4" />
          <circle cx="575" cy="225" r="6" fill="rgb(var(--accent-rgb))" />
          <text x="568" y="216" text-anchor="end" fill="rgb(var(--accent-rgb))" font-size="10.5">v (image)</text>
          <text x="612" y="264" text-anchor="start" fill="currentColor" opacity="0.6" font-size="9.5">projection = score</text>

          {/* shared → math arrow */}
          <path d="M742,245 L784,245" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.6" marker-end="url(#la-arw)" />

          {/* ── the math ── */}
          {/* axis = subtraction */}
          <rect x="786" y="150" width="300" height="74" rx="7" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.45" />
          <text x="936" y="182" text-anchor="middle" fill="currentColor" font-size="12.5">â = normalize( e_warm − e_cool )</text>
          <text x="936" y="204" text-anchor="middle" fill="currentColor" opacity="0.55" font-size="10">an axis is a direction — a subtraction</text>

          {/* connector down */}
          <path d="M936,226 L936,249" fill="none" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.4" marker-end="url(#la-arw)" />

          {/* dot product — focal accent */}
          <rect x="786" y="254" width="300" height="86" rx="7" fill="rgb(var(--accent-rgb) / 0.12)" stroke="rgb(var(--accent-rgb))" stroke-width="1.5" />
          <text x="936" y="298" text-anchor="middle" fill="rgb(var(--accent-rgb))" font-size="27">v · â</text>
          <text x="936" y="323" text-anchor="middle" fill="rgb(var(--accent-rgb))" font-size="11" letter-spacing="1.5">SCORE · ONE DOT PRODUCT</text>

          {/* ── result: one score per image → the field sorts ── */}
          <text x="775" y="404" text-anchor="middle" fill="currentColor" opacity="0.6" font-size="11">one score per image  →  the whole field re-sorts left → right</text>
          <line x1="470" y1="442" x2="1080" y2="442" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.6" marker-end="url(#la-arw)" />
          <line x1="470" y1="435" x2="470" y2="449" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.6" />
          <g>
            <rect x="498" y="435" width="14" height="14" rx="3" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="558" y="435" width="14" height="14" rx="3" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="626" y="435" width="14" height="14" rx="3" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="704" y="435" width="14" height="14" rx="3" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="800" y="435" width="14" height="14" rx="3" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="905" y="435" width="14" height="14" rx="3" fill="rgb(var(--surface-2-rgb))" stroke="currentColor" stroke-opacity="0.5" />
            <rect x="1000" y="435" width="14" height="14" rx="3" fill="rgb(var(--accent-rgb) / 0.18)" stroke="rgb(var(--accent-rgb))" stroke-width="1.3" />
          </g>
          <text x="470" y="466" text-anchor="start" fill="currentColor" opacity="0.7" font-size="10">COOL</text>
          <text x="1080" y="466" text-anchor="end" fill="currentColor" opacity="0.7" font-size="10">WARM</text>

          {/* ── the payoff banner ── */}
          <rect x="40" y="500" width="1100" height="86" rx="8" fill="rgb(var(--accent-rgb) / 0.10)" stroke="rgb(var(--accent-rgb))" stroke-opacity="0.5" />
          <text x="64" y="543" text-anchor="start" fill="rgb(var(--accent-rgb))" font-size="30" letter-spacing="1">NO TRAINING — JUST DOT PRODUCTS</text>
          <text x="64" y="572" text-anchor="start" fill="currentColor" opacity="0.7" font-size="12">Both encoders are pretrained and frozen. Building an axis and placing all 160 images is only vector subtraction and dot products — nothing here learns.</text>
        </svg>
        <figcaption>
          The mechanism · An image and a typed axis land in one CLIP space; the
          axis is a subtraction, each image&apos;s position is a single dot
          product — and no model is trained.
        </figcaption>
      </figure>
    </div>

    <div class="container-reading prose-custom">
      <h2>An axis is a subtraction; a position is a dot product</h2>
      <p>
        To steer, the browser loads CLIP&apos;s <em>text</em> encoder and embeds
        your two poles. The axis is simply the difference of those two vectors,
        normalized — then every poster&apos;s place on it is a single dot product:
      </p>
      <div class="la-formula" role="img" aria-label="axis equals normalized difference of two text embeddings; score equals dot product of a poster embedding with the axis; x equals rescaled score">
<pre><span class="k">axis</span>  = normalize( embed(<span class="s">"warm"</span>) − embed(<span class="s">"cool"</span>) )   <span class="c">// a direction in CLIP space</span>
<span class="k">score</span> = dot( poster.embedding, axis )              <span class="c">// one number per poster</span>
<span class="k">x</span>     = rescale(score)                            <span class="c">// left → right</span></pre>
      </div>
      <p>
        Because the image embeddings and the text-pole embeddings live in the
        <strong>same</strong> space, comparing them is legal by construction. Sort
        by the score and the field re-forms left-to-right; the vertical axis stays
        pinned to a stable secondary component so the horizontal re-sort reads
        cleanly.
      </p>

      <h2>Why this generalizes</h2>
      <p>
        Nothing here is specific to posters. <strong>Any collection you can
        embed</strong> — a photo library, a moodboard, product shots, a design
        archive — can be navigated the same way, with <strong>axes invented on the
        spot in plain language.</strong> There is no classifier to train and no
        taxonomy to maintain; the vocabulary is open-ended because the text encoder
        generalizes. This is the thesis idea — letting a designer move through a
        latent space along <strong>axes they name themselves</strong> — reduced to
        its smallest reproducible core and pointed at an arbitrary image set.
      </p>
    </div>
  </section>

  {/* ── Limitations & what's next — the senior candor ──────────────── */}
  <section class="zone-raised">
    <SectionBreak number="04" label="LIMITATIONS & WHAT'S NEXT" />
    <div class="container-reading pb-14 md:pb-20">
      <p
        class="mb-2"
        style="color: rgb(var(--text-secondary)); line-height: 1.65; max-width: 66ch;"
      >
        What this instrument does <em>not</em> do is as informative as what it does.
        The honest edges:
      </p>

      <div class="honest-list">
        <div class="honest-item">
          <p class="honest-tag mono-label">AXIS QUALITY</p>
          <p class="honest-lead">Some axes barely separate the set — and that stays visible.</p>
          <p class="honest-body">
            On this abstract-poster corpus, <strong>geometric&nbsp;↔&nbsp;organic
            correlates only ~0.1</strong> with the underlying generative parameter,
            versus ~0.8 for warm↔cool and angular↔round. That preset stays in the
            deck on purpose: it is <strong>honest information about what CLIP does
            not cleanly distinguish</strong> on this domain, not a failure to hide.
          </p>
        </div>

        <div class="honest-item">
          <p class="honest-tag mono-label">PERFORMANCE</p>
          <p class="honest-lead">All 160 thumbnails load eagerly — about 5&nbsp;MB up front.</p>
          <p class="honest-body">
            The tiles are 256&nbsp;px PNGs so they stay crisp under the 2.6× hover
            zoom, and they load eagerly to keep panning perfectly smooth. The honest
            cost is <strong>~5&nbsp;MB on first paint.</strong> The fix is
            downscaled, responsively-sized thumbnails with priority hints — deferred
            here so the live interaction, not the loader, stays in the spotlight.
          </p>
        </div>

        <div class="honest-item">
          <p class="honest-tag mono-label">METHOD</p>
          <p class="honest-lead">Axis quality is measured, not eyeballed.</p>
          <p class="honest-body">
            Presets were chosen by <strong>correlating each axis against the known
            generative parameters</strong> of the synthetic set — not by a human
            visually auditing every layout. A high correlation means the sort is
            statistically sound; it does not guarantee the ordering reads perfectly
            to the eye on every tile.
          </p>
        </div>

        <div class="honest-item">
          <p class="honest-tag mono-label">LAYOUT</p>
          <p class="honest-lead">The vertical axis is held fixed.</p>
          <p class="honest-body">
            Y stays pinned to a stable secondary PCA component so the horizontal
            re-sort is the only thing that moves. It is a <strong>legibility choice,
            not a two-axis semantic plane</strong> — a natural next step is a second
            typed axis driving Y.
          </p>
        </div>

        <div class="honest-item">
          <p class="honest-tag mono-label">RUNTIME</p>
          <p class="honest-lead">The first axis triggers a one-time model download.</p>
          <p class="honest-body">
            The CLIP text head (~63&nbsp;MB, quantized) streams from a CDN on first
            use and is cached thereafter. Offline or with the CDN blocked, the map
            still pans and zooms and the control deck <strong>surfaces a clear
            retry</strong> rather than breaking.
          </p>
        </div>
      </div>

      <p class="honest-next">
        <span class="mono-label" style="color: rgb(var(--accent-rgb));">NEXT</span>
        Responsive thumbnails, a second typed axis for a true 2-D semantic plane, and
        a per-axis confidence readout so weak axes announce themselves.
      </p>
    </div>
  </section>

  {/* ── Onward ─────────────────────────────────────────────────────── */}
  <section class="zone-base">
    <div class="container-display py-12 md:py-16">
      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <p class="mono-label" style="color: rgb(var(--text-mono));">RELATED</p>
        <a href="/thesis" class="mono-label la-onward">→ Thesis: Semantic Canvas</a>
        <a href="/latent-space" class="mono-label la-onward">→ Latent project space</a>
        <a href="/work" class="mono-label la-onward">→ All projects</a>
      </div>
    </div>
  </section>

  <style>
    /* onward links */
    .la-onward {
      color: rgb(var(--text-primary));
      transition: color 200ms ease;
    }
    .la-onward:hover {
      color: rgb(var(--accent-rgb));
    }

    /* why-it-matters three-up */
    .why-col p:not(.mono-label) {
      color: rgb(var(--text-secondary));
      line-height: 1.65;
    }
    .why-col strong {
      color: rgb(var(--text-primary));
      font-weight: 600;
    }
    .why-col em {
      color: rgb(var(--text-primary));
      font-style: italic;
    }
    /* the insight column gets a faint accent rail so the spine reads first */
    .why-col--insight {
      border-left: 2px solid rgb(var(--accent-rgb) / 0.55);
      padding-left: 1.25rem;
      margin-left: -1.25rem;
    }
    @media (max-width: 767px) {
      .why-col--insight {
        border-left: 0;
        border-top: 2px solid rgb(var(--accent-rgb) / 0.55);
        padding-left: 0;
        margin-left: 0;
        padding-top: 1.25rem;
      }
    }

    /* diagram frame — inherits figure.diagram breakout + bezel from global.css */
    .la-diagram {
      margin-top: 2.5rem;
      margin-bottom: 2.5rem;
    }

    /* formula card — tokenized so it flips light/dark (no astro-code class,
       which would collide with the Shiki dual-theme swap). */
    .la-formula {
      background: rgb(var(--surface-1-rgb));
      border: 1px solid rgb(var(--surface-border));
      border-radius: 8px;
      padding: 1.1rem 1.3rem;
      margin: 1.75rem 0;
      overflow-x: auto;
    }
    .la-formula pre {
      margin: 0;
      font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace;
      font-size: var(--step--1);
      line-height: 1.9;
      color: rgb(var(--text-primary));
      white-space: pre;
    }
    .la-formula .k { color: rgb(var(--accent-rgb)); }
    .la-formula .s { color: rgb(var(--text-primary)); font-weight: 600; }
