---
// @ts-nocheck
// Permissive vault schema (passthrough) — TS inference collapses on data.X access. v1: bypass.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectMeta from "../../components/ProjectMeta.astro";
import RelatedRail from "../../components/RelatedRail.astro";
import PrevNextNav from "../../components/PrevNextNav.astro";
import PlaceholderHero from "../../components/PlaceholderHero.astro";
import { getCollection, render } from "astro:content";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

function publicFileExists(webPath: string | null | undefined): boolean {
  if (!webPath || !webPath.startsWith("/")) return false;
  const url = new URL(`../../../public${webPath}`, import.meta.url);
  return existsSync(fileURLToPath(url));
}

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.publish === true);
  return projects.map((project) => ({
    params: { slug: ((project as any).slug ?? project.data.slug ?? project.id?.replace(/\.md$/, "")) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const dataAny = data as any;
const { Content } = await render(project);

const hero = data.hero_image || (data.images && data.images[0]) || null;
const heroIsImage = hero && !/\.(pdf|mp4|mov|webm)$/i.test(hero);
const heroExists = heroIsImage && publicFileExists(hero);
const video: string | undefined = dataAny.video && /\.(mp4|webm|mov)$/i.test(dataAny.video) ? dataAny.video : undefined;

// Lead paragraph: prefer summary if present, otherwise null (body will carry it).
const lead: string | undefined = dataAny.summary || dataAny.lead || undefined;

// Mono kicker: categories joined
const kicker = (data.categories ?? []).join(" · ");

const courseOrCat =
  (data.course_code && String(data.course_code)) ||
  (data.categories && data.categories[0]) ||
  "";
const heroMono = [data.year, data.role, courseOrCat].filter(Boolean).join(" · ");

const relatedSlugs: string[] = (dataAny.related_cards ?? []).map((s: string) => String(s));
---

<BaseLayout
  title={data.title}
  description={data.title + (data.course ? ` — ${data.course}` : "")}
  image={hero}
>
  {/* Full-bleed hero block */}
  <section
    class="relative w-full overflow-hidden border-b border-graphite-700/60"
    style="height: 60vh; min-height: 480px;"
  >
    {video ? (
      <video
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 w-full h-full object-cover"
        transition:name={`hero-${((project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, ""))}`}
        src={video}
      />
    ) : heroExists ? (
      <img
        src={hero}
        alt={data.title}
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
        transition:name={`hero-${((project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, ""))}`}
      />
    ) : (
      <div transition:name={`hero-${((project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, ""))}`} class="absolute inset-0">
        <PlaceholderHero
          slug={((project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, ""))}
          title={data.title}
          categories={data.categories ?? []}
          size="hero"
        />
      </div>
    )}

    {/* Bottom gradient overlay */}
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to top, theme(colors.graphite.950) 0%, transparent 60%);"
    ></div>

    {/* Title overlay (bottom-left) */}
    <div class="absolute bottom-0 left-0 right-0" style="padding: 2rem 3rem;">
      <div class="container-page p-0">
        <h1 class="text-graphite-50 max-w-4xl mb-3" style="font-size: var(--step-5); font-weight: 380; line-height: 1.05; text-shadow: 0 2px 16px rgba(0,0,0,0.5);">
          {data.title}
        </h1>
        {heroMono && (
          <p class="mono-label" style="text-shadow: 0 1px 8px rgba(0,0,0,0.5);">{heroMono}</p>
        )}
      </div>
    </div>
  </section>

  {/* Title block / lead */}
  <section class="container-reading py-12 md:py-16">
    {kicker && (
      <p class="mono-label mb-5">{kicker}</p>
    )}
    {lead && (
      <p class="text-graphite-200 max-w-prose" style="font-size: var(--step-1); font-weight: 350; line-height: 1.55;">
        {lead}
      </p>
    )}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10 pt-8 border-t border-graphite-700/60">
      {data.role && (
        <div>
          <p class="mono-label mb-1">Role</p>
          <p class="text-graphite-100">{data.role}</p>
        </div>
      )}
      {(data.team && data.team.length > 0) || data.team_size ? (
        <div>
          <p class="mono-label mb-1">Team</p>
          <p class="text-graphite-100">
            {data.team && data.team.length > 0
              ? data.team
                  .filter((n: string) => n !== "David Chen" && n !== "Tianle Chen")
                  .join(", ") || "Solo"
              : `Team of ${data.team_size}`}
          </p>
        </div>
      ) : null}
      {data.tags && data.tags.length > 0 && (
        <div>
          <p class="mono-label mb-1">Stack</p>
          <p class="text-graphite-100">{data.tags.slice(0, 6).join(", ")}</p>
        </div>
      )}
    </div>
  </section>

  {/* Horizontal meta strip */}
  <ProjectMeta data={data} />

  {/* Body */}
  <section class="py-12 md:py-16">
    <article class="container-reading prose-custom">
      <Content />
    </article>
  </section>

  {/* Image gallery (remaining images beyond hero) */}
  {data.images && data.images.filter((img: string) => img !== hero && !/\.(pdf|mp4|mov|webm)$/i.test(img) && publicFileExists(img)).length > 0 && (
    <section class="container-page py-12 md:py-16 border-t border-graphite-700/60">
      <h2 class="mb-10" style="font-size: var(--step-3); font-weight:380;">Gallery</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {data.images
          .filter((img: string) => img !== hero && !/\.(pdf|mp4|mov|webm)$/i.test(img) && publicFileExists(img))
          .map((img: string) => (
            <div class="rounded-md overflow-hidden bg-graphite-900 border border-graphite-700/60">
              <img src={img} alt="" loading="lazy" decoding="async" class="w-full h-auto" />
            </div>
          ))}
      </div>
    </section>
  )}

  <RelatedRail
    currentSlug={((project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, ""))}
    relatedSlugs={relatedSlugs}
    categories={data.categories ?? []}
  />

  <PrevNextNav currentSlug={((project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, ""))} />
</BaseLayout>
