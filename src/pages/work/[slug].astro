---
// @ts-nocheck
// Permissive vault schema (passthrough) — TS inference collapses on data.X access. v1: bypass.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProjectMeta from "../../components/ProjectMeta.astro";
import RelatedRail from "../../components/RelatedRail.astro";
import PrevNextNav from "../../components/PrevNextNav.astro";
import PlaceholderHero from "../../components/PlaceholderHero.astro";
import SectionBreak from "../../components/SectionBreak.astro";
import { getCollection, render } from "astro:content";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

function publicFileExists(webPath: string | null | undefined): boolean {
  if (!webPath) return false;
  if (/^https?:\/\//i.test(webPath)) return true;
  if (!webPath.startsWith("/")) return false;
  const url = new URL(`../../../public${webPath}`, import.meta.url);
  return existsSync(fileURLToPath(url));
}

function isEmbedUrl(u: string | null | undefined): boolean {
  if (!u) return false;
  return /youtube\.com|youtu\.be|vimeo\.com/i.test(u);
}

function toEmbedSrc(u: string): string | null {
  let m = u.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([A-Za-z0-9_-]{6,})/);
  if (m) return `https://www.youtube.com/embed/${m[1]}`;
  m = u.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (m) return `https://player.vimeo.com/video/${m[1]}`;
  return null;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.publish === true);
  return projects.map((project) => ({
    params: { slug: ((project as any).slug ?? project.data.slug ?? project.id?.replace(/\.md$/, "")) },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const dataAny = data as any;
const { Content } = await render(project);

// Media resolution: gif_hero > video (local) > video (embed) > hero_image > placeholder.
// Round-5 Fix 1+2: when frontmatter explicitly sets `hero_image: null`, honor
// the null and let the designed PlaceholderHero render. Do NOT fall through
// to images[0] — projects without a canonical photo-quality hero deserve a
// designed editorial moment, not a sprite or chart cropped at 60vh.
const gifHero: string | undefined = dataAny.gif_hero;
const heroExplicitlyNull = data.hero_image === null;
const heroImg = heroExplicitlyNull
  ? null
  : (data.hero_image || (data.images && data.images[0]) || null);
const heroIsImage = heroImg && !/\.(pdf|mp4|mov|webm)$/i.test(heroImg);
const heroExists = heroIsImage && publicFileExists(heroImg);

const rawVideo: string | undefined = dataAny.video;
const localVideo: string | undefined = rawVideo && /\.(mp4|webm|mov)$/i.test(rawVideo) ? rawVideo : undefined;
const heroEmbedUrl: string | undefined = rawVideo && isEmbedUrl(rawVideo) ? rawVideo : undefined;
const heroEmbedSrc: string | null = heroEmbedUrl ? toEmbedSrc(heroEmbedUrl) : null;

const videoProposal: string | undefined = dataAny.video_proposal;

// Lead paragraph: prefer summary if present.
const lead: string | undefined = dataAny.summary || dataAny.lead || undefined;

// Mono kicker: categories joined
const kicker = (data.categories ?? []).join(" · ");

const courseOrCat =
  (data.course_code && String(data.course_code)) ||
  (data.categories && data.categories[0]) ||
  data.institution ||
  "";
const heroMonoBits = [data.year, data.role, courseOrCat].filter(Boolean);
const heroMono = heroMonoBits.join(" · ");

const relatedSlugs: string[] = (dataAny.related_cards ?? []).map((s: string) => String(s));

// Gallery image filtering — render every image whose file exists in public/.
// Skip: the hero, the gif_hero, and any non-image artifacts.
const galleryImages: string[] = (data.images ?? []).filter(
  (img: string) =>
    img !== heroImg &&
    img !== gifHero &&
    !/\.(pdf|mp4|mov|webm)$/i.test(img) &&
    publicFileExists(img)
);
const imageCaptions: string[] = Array.isArray(dataAny.image_captions) ? dataAny.image_captions : [];

function captionFor(img: string): string | undefined {
  const allImgs: string[] = data.images ?? [];
  const idx = allImgs.indexOf(img);
  if (idx >= 0 && imageCaptions[idx]) return imageCaptions[idx];
  return undefined;
}

const slugVal = (project as any).slug ?? data.slug ?? project.id?.replace(/\.md$/, "");
const primaryCategory = (data.categories && data.categories[0]) || undefined;

// Per-project JSON-LD (CreativeWork) — makes each project a resolvable entity.
// If it has a code repo, SoftwareSourceCode is a more specific type.
const repoUrl: string | undefined =
  dataAny.github_url || (dataAny.github ? `https://github.com/${dataAny.github}` : undefined);
const projectDescription: string =
  lead || data.title + (data.course ? ` — ${data.course}` : "");
const projectStructuredData = {
  "@type": repoUrl ? "SoftwareSourceCode" : "CreativeWork",
  name: data.title,
  description: projectDescription,
  url: new URL(`/work/${slugVal}`, Astro.site).toString(),
  ...(heroExists || gifHero ? { image: new URL(heroImg, Astro.site).toString() } : {}),
  ...(data.year ? { dateCreated: String(data.year) } : {}),
  ...(data.categories?.length ? { keywords: data.categories.join(", ") } : {}),
  ...(repoUrl ? { codeRepository: repoUrl } : {}),
  author: { "@id": new URL("/#person", Astro.site).toString() },
  creator: { "@id": new URL("/#person", Astro.site).toString() },
};
---

<BaseLayout
  title={data.title}
  description={data.title + (data.course ? ` — ${data.course}` : "")}
  image={heroImg}
  structuredData={projectStructuredData}
>
  <Breadcrumb category={primaryCategory} title={data.title} />

  {/* ============ HERO BLOCK — with scrim fix, zone-base ============ */}
  <section
    class="relative w-full overflow-hidden zone-base"
    style="height: 60vh; min-height: 480px; border-bottom: 1px solid rgb(var(--surface-border));"
  >
    {gifHero && publicFileExists(gifHero) ? (
      <img
        src={gifHero}
        alt={data.title}
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
        transition:name={`hero-${slugVal}`}
      />
    ) : localVideo ? (
      <video
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 w-full h-full object-cover"
        transition:name={`hero-${slugVal}`}
        src={localVideo}
      />
    ) : heroEmbedSrc ? (
      <div class="absolute inset-0 w-full h-full" style="background: rgb(var(--surface-bg));" transition:name={`hero-${slugVal}`}>
        <iframe
          src={heroEmbedSrc}
          title={data.title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="absolute inset-0 w-full h-full"
          style="border: 0;"
        ></iframe>
      </div>
    ) : heroExists ? (
      <img
        src={heroImg}
        alt={data.title}
        loading="eager"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
        transition:name={`hero-${slugVal}`}
      />
    ) : (
      <div transition:name={`hero-${slugVal}`} class="absolute inset-0">
        <PlaceholderHero
          slug={slugVal}
          title={data.title}
          categories={data.categories ?? []}
          size="hero"
        />
      </div>
    )}

    {/* Scrim — fix for white-on-white text-on-image collision (skip on iframe) */}
    {!heroEmbedSrc && (
      <div class="hero-scrim" aria-hidden="true"></div>
    )}

    {/* Title overlay (skip on iframe so video controls remain clickable) */}
    {!heroEmbedSrc && (
      <div class="absolute bottom-0 left-0 right-0 pointer-events-none" style="padding-block: 2rem 2.5rem;">
        <div class="container-display">
          {heroMono && (
            <div class="mono-label mb-3" style="color: rgba(255,255,255,0.72);">
              {heroMono}
            </div>
          )}
          <h1
            class="font-display h1-fluid text-white max-w-4xl"
            style="letter-spacing: -0.01em;"
          >
            {data.title}
          </h1>
        </div>
      </div>
    )}
  </section>

  {/* Title block when iframe consumed the hero overlay */}
  {heroEmbedSrc && (
    <section class="zone-base" style="border-bottom: 1px solid rgb(var(--surface-border));">
      <div class="container-display py-10">
        <h1 style="font-family: theme(fontFamily.display); font-size: var(--step-5); font-weight: 380; line-height: 1.05; color: rgb(var(--text-primary));">
          {data.title}
        </h1>
        {heroMono && <p class="mono-label mt-3">{heroMono}</p>}
      </div>
    </section>
  )}

  {/* ============ LEAD BLOCK — zone-raised ============ */}
  {lead && (
    <section class="zone-raised">
      <SectionBreak number="01" label="OVERVIEW" />
      <div class="container-meta pb-12 md:pb-16">
        {kicker && (
          <p class="mono-label mb-5">{kicker}</p>
        )}
        <p
          style="color: rgb(var(--text-secondary)); font-size: var(--step-1); font-weight: 350; line-height: 1.55;"
        >
          {lead}
        </p>
      </div>
    </section>
  )}

  {/* ============ BODY MDX — zone-base, single beefy left rail (Round-9f).
      The right rail was dropped; all metadata + links live in the left
      rail now so the reader has one consolidated sidebar instead of
      eyes flicking between two thin columns. ============ */}
  <section class="zone-base">
    <SectionBreak number="02" label="WRITEUP" />
    <div class="layout-with-rails py-12 md:py-16">
    <aside class="rail-left hidden lg:block">
      <div class="sticky space-y-5" style="top: 6rem;">
        {/* — Project metadata — */}
        <div class="space-y-1.5">
          {data.year && (
            <div>
              <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">YEAR</div>
              <div class="mono-label">{data.year}</div>
            </div>
          )}
          {data.role && (
            <div>
              <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">ROLE</div>
              <div class="mono-label">{String(data.role).replace(/-/g, " ")}</div>
            </div>
          )}
          {(data.course_code || data.course) && (
            <div>
              <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">CONTEXT</div>
              <div class="mono-label" style="white-space: normal; line-height: 1.4;">
                {data.course_code ?? data.course}
              </div>
            </div>
          )}
          {data.institution && (
            <div>
              <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">INSTITUTION</div>
              <div class="mono-label">{data.institution}</div>
            </div>
          )}
          {(Array.isArray(data.tools) && data.tools.length > 0) && (
            <div>
              <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">TOOLS</div>
              <div class="mono-label" style="white-space: normal; line-height: 1.5;">
                {data.tools.join(" · ")}
              </div>
            </div>
          )}
          {(Array.isArray(data.collaborators) && data.collaborators.length > 0) && (
            <div>
              <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">COLLAB</div>
              <div class="mono-label" style="white-space: normal; line-height: 1.5;">
                {data.collaborators.join(" · ")}
              </div>
            </div>
          )}
          {data.team_size && !data.collaborators && (
            <div>
              <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">TEAM</div>
              <div class="mono-label">{data.team_size}</div>
            </div>
          )}
        </div>

        {/* — Links — */}
        {(data.live_url || data.github_url || data.notion_url || data.publication_url) && (
          <div class="space-y-1.5 pt-3" style="border-top: 1px solid rgb(var(--surface-border));">
            <div class="mono-label" style="color: rgb(var(--text-mono)); opacity: 0.6;">LINKS</div>
            {data.live_url && (
              <a href={data.live_url} target="_blank" rel="noopener noreferrer"
                 class="block mono-label hover:text-[rgb(var(--accent-rgb))] transition-colors">
                LIVE ↗
              </a>
            )}
            {data.github_url && (
              <a href={data.github_url} target="_blank" rel="noopener noreferrer"
                 class="block mono-label hover:text-[rgb(var(--accent-rgb))] transition-colors">
                CODE ↗
              </a>
            )}
            {data.publication_url && (
              <a href={data.publication_url} target="_blank" rel="noopener noreferrer"
                 class="block mono-label hover:text-[rgb(var(--accent-rgb))] transition-colors">
                PAPER ↗
              </a>
            )}
            {data.notion_url && (
              <a href={data.notion_url} target="_blank" rel="noopener noreferrer"
                 class="block mono-label hover:text-[rgb(var(--accent-rgb))] transition-colors">
                NOTION ↗
              </a>
            )}
          </div>
        )}
      </div>
    </aside>
    <article class="prose-custom">
      <Content />
    </article>
    </div>
  </section>

  {/* ============ IMAGE GALLERY — zone-raised ============ */}
  {galleryImages.length > 0 && (
    <section class="zone-raised">
      <SectionBreak number="03" label="GALLERY" />
      <div class="container-display pb-12 md:pb-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6">
          {galleryImages.map((img: string, i: number) => {
            const cap = captionFor(img);
            // Round-3 Item 9: fallback alt uses the project title + index so
            // screen readers don't get empty alt on every project artifact.
            const altText = cap ?? `${data.title} — image ${i + 1}`;
            return (
              <figure class="m-0">
                <a
                  href={img}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block overflow-hidden"
                  style="border: 1px solid rgb(var(--surface-border)); border-radius: 6px; background: rgb(var(--surface-1-rgb));"
                >
                  <img
                    src={img}
                    alt={altText}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-auto block"
                  />
                </a>
                {cap && (
                  <figcaption class="mt-2 mono-label">{cap}</figcaption>
                )}
              </figure>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* ============ HORIZONTAL META STRIP — zone-base ============ */}
  <section class="zone-base">
    <ProjectMeta data={data} />
  </section>

  {/* ============ PROPOSAL VIDEO BLOCK (if video_proposal set) — zone-raised ============ */}
  {videoProposal && publicFileExists(videoProposal) && (
    <section class="zone-raised">
      <SectionBreak number="04" label="PROPOSAL PRESENTATION" />
      <div class="container-display pb-12 md:pb-16">
        <video
          src={videoProposal}
          controls
          preload="metadata"
          class="w-full block"
          style="border: 1px solid rgb(var(--surface-border)); border-radius: 6px;"
        ></video>
      </div>
    </section>
  )}

  <RelatedRail
    currentSlug={slugVal}
    relatedSlugs={relatedSlugs}
    categories={data.categories ?? []}
  />

  <PrevNextNav currentSlug={slugVal} />
</BaseLayout>
