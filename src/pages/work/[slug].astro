---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.publish === true);
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Related: other projects in same categories
const all = await getCollection("projects", ({ data }) => data.publish === true);
const related = all
  .filter((p) => p.data.slug !== data.slug)
  .filter((p) => {
    const myCats = new Set(data.categories ?? []);
    return (p.data.categories ?? []).some((c: string) => myCats.has(c));
  })
  .slice(0, 3);

const hero = data.hero_image || (data.images && data.images[0]);
---

<BaseLayout title={data.title} description={data.title + (data.course ? ` — ${data.course}` : "")} image={hero}>
  {/* Project hero */}
  <section class="container-full pt-16 md:pt-24 pb-8">
    <div class="max-w-4xl mb-10 md:mb-12">
      <div class="flex flex-wrap items-center gap-3 mb-6 font-mono text-xs uppercase tracking-[0.2em] text-ink-400">
        {data.year && <span>{data.year}</span>}
        {data.semester && <><span class="text-ink-600">·</span><span>{data.semester}</span></>}
        {data.course && <><span class="text-ink-600">·</span><span>{data.course}</span></>}
        {data.priority === "flagship" && <span class="text-accent">· flagship</span>}
      </div>
      <h1 class="mb-6">{data.title}</h1>
      {data.role && (
        <p class="text-ink-300 text-lg">
          Role: <span class="text-ink-100">{data.role}</span>
          {data.team_size && typeof data.team_size === "number" && data.team_size > 1 && (
            <> · Team of {data.team_size}{data.team_hierarchy ? ` (${data.team_hierarchy})` : ""}</>
          )}
        </p>
      )}
      {data.team && data.team.length > 0 && (
        <p class="text-ink-400 text-sm mt-2">
          With {data.team.filter((n: string) => n !== "David Chen" && n !== "Tianle Chen").join(", ")}
        </p>
      )}
    </div>
  </section>

  {/* Hero image */}
  {hero && (
    <section class="container-full pb-10 md:pb-16">
      <div class="rounded-xl overflow-hidden bg-ink-900 shadow-2xl">
        <img
          src={hero}
          alt={data.title}
          class="w-full h-auto"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>
  )}

  {/* Action bar */}
  <section class="container-full py-6 border-y border-ink-800/50">
    <div class="flex flex-wrap gap-3 items-center">
      {data.github_url && (
        <a href={data.github_url} target="_blank" rel="noopener noreferrer" class="btn">
          <span>GitHub</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {data.live_url && (
        <a href={data.live_url} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <span>Live demo</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {data.video && (
        <a href={data.video} target="_blank" rel="noopener noreferrer" class="btn">
          <span>Video</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {data.publication_url && (
        <a href={data.publication_url} target="_blank" rel="noopener noreferrer" class="btn">
          <span>Paper</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {data.tags && data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 ml-auto">
          {data.tags.slice(0, 6).map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </div>
  </section>

  {/* Body */}
  <section class="container-narrow py-12 md:py-16">
    <article class="prose-custom">
      <Content />
    </article>
  </section>

  {/* Image gallery (remaining images beyond hero) */}
  {data.images && data.images.length > 1 && (
    <section class="container-full py-12 md:py-16 border-t border-ink-800/50">
      <h2 class="mb-10">Gallery</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {data.images.filter((img: string) => img !== hero).map((img: string) => (
          <div class="rounded-lg overflow-hidden bg-ink-900 shadow-xl">
            <img src={img} alt="" loading="lazy" decoding="async" class="w-full h-auto" />
          </div>
        ))}
      </div>
    </section>
  )}

  {/* Related */}
  {related.length > 0 && (
    <section class="container-full py-16 md:py-24 border-t border-ink-800/50">
      <h2 class="mb-10">Related work</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {related.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
