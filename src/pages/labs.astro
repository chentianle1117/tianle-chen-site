---
// @ts-nocheck
import BaseLayout from "../layouts/BaseLayout.astro";

// Labs index — curated set of standalone interactive instruments.
// Each lab is a self-contained in-browser build (no server, no API keys)
// extending ideas from research + practice. Staged labs (pending review)
// are intentionally NOT listed here.
const labs = [
  {
    href: "/latent-atlas",
    num: "01",
    title: "Latent Atlas",
    flagship: true,
    thesis:
      "Navigate an image collection by meaning — type any semantic axis and watch CLIP space reorganize. No training, just dot products.",
    tags: ["CLIP", "LATENT SPACE", "IN-BROWSER ML"],
  },
  {
    href: "/vision-lab",
    num: "02",
    title: "Vision Lab",
    flagship: false,
    thesis:
      "Real computer-vision models running entirely in your browser — WebGPU inference, zero servers, images never leave your device.",
    tags: ["ONNX · WEBGPU", "ZERO-SHOT CLIP", "MONOCULAR DEPTH"],
  },
  {
    href: "/section-studio",
    num: "03",
    title: "Section Studio",
    flagship: false,
    thesis:
      "Slice any solid and read its section live — plane–mesh intersection computed from scratch, measured, and exportable as SVG.",
    tags: ["THREE.JS", "COMPUTATIONAL GEOMETRY", "SVG EXPORT"],
  },
];
---

<BaseLayout
  title="Labs — interactive instruments"
  description="Standalone interactive instruments — in-browser ML, latent-space navigation, and computational geometry. Everything runs live in your browser; nothing leaves your device."
>
  <section class="zone-base">
    <div class="container-display" style="padding-block: 5rem 6rem;">
      {/* Header */}
      <div style="max-width: 46rem;">
        <div
          class="font-mono"
          style="color: rgb(var(--accent-rgb)); font-size: var(--step--1); letter-spacing: 0.14em; text-transform: uppercase;"
        >
          Labs — interactive instruments
        </div>
        <h1
          class="font-display mt-4"
          style="font-size: var(--step-4); line-height: 1.08; color: rgb(var(--text-primary)); font-weight: 480; letter-spacing: -0.01em;"
        >
          Ideas you can operate, not just read about.
        </h1>
        <p
          class="mt-5"
          style="color: rgb(var(--text-secondary)); font-size: var(--step-0); line-height: 1.7;"
        >
          A series of <strong style="color: rgb(var(--text-primary));">standalone instruments</strong> extending
          ideas from my research and practice — latent-space navigation, on-device
          computer vision, computational geometry. Each one runs
          <strong style="color: rgb(var(--text-primary));">entirely in your browser</strong>:
          no server, no API keys, nothing uploaded anywhere.
        </p>
      </div>

      {/* Cards */}
      <div class="labs-grid mt-14">
        {labs.map((lab) => (
          <a
            href={lab.href}
            class={`lab-card ${lab.flagship ? "lab-card--flagship" : ""}`}
          >
            <div class="flex items-baseline justify-between gap-4">
              <span
                class="font-mono"
                style="color: rgb(var(--text-muted)); font-size: var(--step--1); letter-spacing: 0.1em;"
              >
                {lab.num}
              </span>
              {lab.flagship && (
                <span
                  class="font-mono lab-badge"
                  style="font-size: 10px; letter-spacing: 0.12em;"
                >
                  FLAGSHIP
                </span>
              )}
            </div>
            <h2
              class="font-display mt-3"
              style="font-size: var(--step-2); color: rgb(var(--text-primary)); font-weight: 480; line-height: 1.15;"
            >
              {lab.title}
            </h2>
            <p
              class="mt-3 lab-thesis"
              style="color: rgb(var(--text-secondary)); font-size: var(--step-0); line-height: 1.65;"
            >
              {lab.thesis}
            </p>
            <div class="mt-5 flex flex-wrap gap-x-4 gap-y-1.5">
              {lab.tags.map((t) => (
                <span
                  class="font-mono"
                  style="color: rgb(var(--text-mono)); font-size: 11px; letter-spacing: 0.08em;"
                >
                  {t}
                </span>
              ))}
            </div>
            <div
              class="font-mono mt-6 lab-open"
              style="font-size: var(--step--1); letter-spacing: 0.1em;"
            >
              OPEN INSTRUMENT <span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>

      {/* Footnote */}
      <p
        class="font-mono mt-12"
        style="color: rgb(var(--text-muted)); font-size: var(--step--1); line-height: 1.7; max-width: 42rem;"
      >
        All datasets procedurally generated or user-supplied. Model weights load
        once from public hubs and are cached by your browser. More instruments in
        progress.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .labs-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) {
    .labs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .lab-card--flagship {
      grid-column: 1 / -1;
    }
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.75rem 1.5rem;
    border: 1px solid rgb(var(--surface-border));
    border-radius: 8px;
    background: rgb(var(--surface-1-rgb) / 0.5);
    text-decoration: none;
    transition: border-color 220ms ease, background 220ms ease, transform 220ms ease;
  }
  .lab-card:hover {
    border-color: rgb(var(--accent-rgb) / 0.55);
    background: rgb(var(--surface-1-rgb));
    transform: translateY(-2px);
  }
  .lab-card--flagship {
    border-color: rgb(var(--accent-rgb) / 0.35);
    background: linear-gradient(
      135deg,
      rgb(var(--surface-1-rgb) / 0.85),
      rgb(var(--surface-1-rgb) / 0.4)
    );
  }

  .lab-badge {
    color: rgb(var(--accent-rgb));
    border: 1px solid rgb(var(--accent-rgb) / 0.4);
    border-radius: 3px;
    padding: 3px 7px;
  }

  .lab-open {
    color: rgb(var(--text-muted));
    margin-top: auto;
    padding-top: 1.25rem;
    transition: color 220ms ease;
  }
  .lab-card:hover .lab-open {
    color: rgb(var(--accent-rgb));
  }
</style>
