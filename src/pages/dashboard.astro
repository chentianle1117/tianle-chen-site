---
import BaseLayout from "../layouts/BaseLayout.astro";
import DashboardPanel from "../components/DashboardPanel.astro";
import Sparkline from "../components/Sparkline.astro";
import Donut from "../components/Donut.astro";
import { execSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import pkg from "../../package.json";
import {
  FILTER_CATEGORIES,
  domainForProject,
  METHODS,
  methodsForProject,
  MATRIX_LABS,
} from "../lib/categories";
import overrides from "../../scripts/project_overrides.json";
import { getProjectCounts } from "../lib/projectCounts";

// ── Build info ───────────────────────────────────────────────────────────
const today = new Date().toISOString().slice(0, 10);

let commit = "unknown";
try {
  commit = execSync("git rev-parse --short HEAD", { stdio: ["ignore", "pipe", "ignore"] })
    .toString()
    .trim();
} catch {
  commit = "unknown";
}

const astroVersion =
  ((pkg as any).dependencies?.astro ?? (pkg as any).devDependencies?.astro ?? "5")
    .replace(/^\^/, "")
    .replace(/^~/, "");

// ── Last 5 commits ───────────────────────────────────────────────────────
type Commit = { hash: string; subject: string; date: string };
let recentCommits: Commit[] = [];
try {
  const out = execSync('git log -5 --pretty=format:"%h|%s|%ad" --date=short', {
    stdio: ["ignore", "pipe", "ignore"],
  }).toString();
  recentCommits = out
    .split("\n")
    .filter(Boolean)
    .map((line) => {
      const [hash, subject, date] = line.replace(/^"|"$/g, "").split("|");
      return { hash, subject, date };
    });
} catch {
  recentCommits = [];
}

// ── Content stats ────────────────────────────────────────────────────────
// Round-5 Fix 4: route through projectCounts.ts (single source of truth).
const { all: allCollection, counts: projectCounts } = await getProjectCounts();
const all: any[] = allCollection;

const projectCount = projectCounts.all;

const totalChars = all.reduce(
  (sum: number, p: any) => sum + ((p.body as string | undefined)?.length ?? 0),
  0
);
const totalWords = Math.round(totalChars / 5 / 100) * 100;
const wordsLabel =
  totalWords >= 10000
    ? `${Math.round(totalWords / 1000)}K`
    : totalWords.toLocaleString();

// Use the canonical 4-bucket taxonomy used by /work, not the raw frontmatter set.
const categoryCount = FILTER_CATEGORIES.length;

const imageCount: number = all.reduce(
  (sum: number, p: any) =>
    sum +
    (((p.data.images ?? []) as string[]).length || 0) +
    (p.data.hero_image ? 1 : 0),
  0
);

// ── Project distribution by year ─────────────────────────────────────────
const byYear: Record<number, number> = {};
for (const p of all) {
  const y = (p.data as any).year as number | undefined;
  if (typeof y === "number") {
    byYear[y] = (byYear[y] ?? 0) + 1;
  }
}
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => a - b);
const minY = years.length ? years[0] : 2022;
const maxY = years.length ? years[years.length - 1] : 2026;
const distData: { label: string; value: number }[] = [];
for (let y = minY; y <= maxY; y++) {
  distData.push({ label: String(y).slice(-2), value: byYear[y] ?? 0 });
}

// ── Category buckets — uses the canonical FILTER_CATEGORIES from /work ──
// Category palette — matches the latent-space scatter legend; all mid-tone so
// every wedge stays legible in BOTH themes (the old ramp ended in near-black
// #1a1c20, which rendered as a stuck-dark wedge on the light dashboard).
// 4-domain palette — matches the home scatter colors.
const bucketColors: Record<string, string> = {
  "AI / ML": "#9b6fc9",
  Interactive: "#d49b50",
  "Computational Design": "#7aa15c",
  Architecture: "#5fa0a6",
};
const bucketCounts: Record<string, number> = Object.fromEntries(
  FILTER_CATEGORIES.map((b) => [b, 0])
);
for (const p of all) {
  const slug = (p as any).slug ?? (p.data as any).slug ?? p.id?.replace(/\.md$/, "");
  const prim = (overrides as any)[slug]?.primary_category;
  const b = domainForProject(prim, ((p.data as any).categories ?? []) as string[]);
  bucketCounts[b] = (bucketCounts[b] ?? 0) + 1;
}
const donutData = FILTER_CATEGORIES.map((b) => ({
  label: b,
  value: bucketCounts[b] ?? 0,
  color: bucketColors[b],
}));

// ── Method-depth split — the technique-kind dimension (see categories.ts) ──
// Counts projects + lab instruments per method (primary or secondary), in the
// depth-ordered spectrum so the range from model-training to interface craft
// is visible here too.
const methodSplit = METHODS.map((m) => {
  let count = 0;
  for (const p of all) {
    const slug =
      (p as any).slug ?? (p.data as any).slug ?? p.id?.replace(/\.md$/, "");
    if (methodsForProject(slug).includes(m.key)) count++;
  }
  for (const lab of MATRIX_LABS) {
    if (methodsForProject(lab.slug).includes(m.key)) count++;
  }
  return { ...m, count };
});
const methodMax = Math.max(1, ...methodSplit.map((m) => m.count));

// ── Latency placeholders (honest measured-where-possible) ─────────────────
let routeCount = 0;
try {
  const pagesDir = path.resolve(process.cwd(), "src/pages");
  const walk = (d: string): string[] => {
    const out: string[] = [];
    for (const f of fs.readdirSync(d, { withFileTypes: true })) {
      const full = path.join(d, f.name);
      if (f.isDirectory()) out.push(...walk(full));
      else if (/\.(astro|md|mdx|ts)$/.test(f.name)) out.push(full);
    }
    return out;
  };
  routeCount = walk(pagesDir).length;
} catch {
  routeCount = 0;
}

const stack = [
  { name: "Astro", url: "https://astro.build" },
  { name: "Tailwind CSS", url: "https://tailwindcss.com" },
  { name: "Three.js", url: "https://threejs.org" },
  { name: "React Three Fiber", url: "https://r3f.docs.pmnd.rs" },
  { name: "OpenCLIP", url: "https://github.com/mlfoundations/open_clip" },
  { name: "UMAP", url: "https://umap-learn.readthedocs.io" },
  { name: "Newsreader / Inter Tight / IBM Plex Mono", url: "https://fontsource.org" },
];
---

<BaseLayout
  title="Dashboard"
  description="Site dashboard — content stats, project distribution, build stack, and recent commits."
>
  <div class="page-with-rails">
    {/* Round-5 Fix 8: marginalia rails at >=1440 */}
    <aside class="page-rail page-rail-left" aria-hidden="true">
      <span class="rail-row">INTERNALS</span>
      <span class="rail-row faint">{today}</span>
    </aside>
    <aside class="page-rail page-rail-right">
      <a class="rail-row" href="#top" aria-label="Back to top">↑ TOP</a>
    </aside>

  <section class="container-page pt-24 md:pt-32 pb-12">
    <p class="mono-label mb-4">Dashboard · {today}</p>
    <h1 class="mb-4">Dashboard</h1>
    <p class="text-graphite-300 max-w-reading leading-relaxed">
      A small honest panel of what this site is made of — content, distribution, and
      stack. Numbers below are computed at build time.
    </p>
  </section>

  <section class="container-page pb-24">
    <div class="grid grid-cols-12 gap-6">
      {/* 1 — Build info */}
      <DashboardPanel label="Build info" span={6}>
        <div class="font-mono text-sm space-y-2 text-graphite-200">
          <p>
            <span class="text-graphite-400">BUILT </span>
            <span>{today}</span>
          </p>
          <p>
            <span class="text-graphite-400">COMMIT </span>
            <span>{commit}</span>
          </p>
          <p>
            <span class="text-graphite-400">ASTRO </span>
            <span>{astroVersion}</span>
          </p>
        </div>
      </DashboardPanel>

      {/* 2 — Content stats */}
      <DashboardPanel label="Content stats" span={6}>
        <div class="grid grid-cols-2 gap-4 font-mono text-sm">
          <div>
            <p class="text-3xl font-display" style="font-weight:500; color: rgb(var(--text-primary));">{projectCount}</p>
            <p class="mono-label mt-1">Projects</p>
          </div>
          <div>
            <p class="text-3xl font-display" style="font-weight:500; color: rgb(var(--text-primary));">{wordsLabel}</p>
            <p class="mono-label mt-1">Words</p>
          </div>
          <div>
            <p class="text-3xl font-display" style="font-weight:500; color: rgb(var(--text-primary));">{categoryCount}</p>
            <p class="mono-label mt-1">Categories</p>
          </div>
          <div>
            <p class="text-3xl font-display" style="font-weight:500; color: rgb(var(--text-primary));">{imageCount}</p>
            <p class="mono-label mt-1">Images</p>
          </div>
        </div>
      </DashboardPanel>

      {/* 3 — Project distribution */}
      <DashboardPanel label="Projects per year" span={7}>
        <div class="min-h-[280px]">
          <Sparkline data={distData} height={260} />
        </div>
      </DashboardPanel>

      {/* 4 — Category split */}
      <DashboardPanel label="Category split" span={5}>
        <Donut data={donutData} size={180} />
      </DashboardPanel>

      {/* 4b — Method depth (technique-kind dimension) */}
      <DashboardPanel label="Method depth" span={12}>
        <p class="mono-label mb-4" style="color: rgb(var(--text-mono));">
          MODEL-BUILDING → INTERFACE CRAFT · projects + labs per technique
        </p>
        <div class="space-y-2.5 font-mono text-sm">
          {methodSplit.map((m) => (
            <div class="grid grid-cols-[8.5rem_1fr_1.75rem] gap-3 items-center">
              <span
                class="mono-label"
                style={`color: ${m.tier === "ml" ? "rgb(var(--accent-rgb))" : "rgb(var(--text-mono))"};`}
              >
                {m.chip}
              </span>
              <div
                style="height: 8px; border-radius: 3px; background: rgb(var(--surface-2-rgb)); overflow: hidden;"
              >
                <div
                  style={`height: 100%; width: ${(m.count / methodMax) * 100}%; min-width: 3px; border-radius: 3px; background: ${m.tier === "ml" ? "rgb(var(--accent-rgb))" : "rgb(var(--text-muted))"};`}
                ></div>
              </div>
              <span
                style="text-align: right; color: rgb(var(--text-primary)); font-variant-numeric: tabular-nums;"
              >
                {m.count}
              </span>
            </div>
          ))}
        </div>
      </DashboardPanel>

      {/* 5 — Built with */}
      <DashboardPanel label="Built with" span={6}>
        <ul class="font-mono text-sm space-y-2">
          {stack.map((s) => (
            <li class="grid grid-cols-[14rem_1fr] gap-3 items-baseline">
              <span class="text-graphite-200">{s.name}</span>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-graphite-400 hover:text-oxide-400 truncate transition-colors"
              >
                {s.url.replace(/^https?:\/\//, "")}
              </a>
            </li>
          ))}
        </ul>
      </DashboardPanel>

      {/* 6 — Latency */}
      <DashboardPanel label="Latency" span={6}>
        <div class="font-mono text-sm space-y-2 text-graphite-200">
          <p>
            <span class="text-graphite-400">JS SHIPPED </span>
            <span>~80KB</span>
            <span class="text-graphite-500"> (first load, est.)</span>
          </p>
          <p>
            <span class="text-graphite-400">LARGEST IMAGE </span>
            <span>~1.2MB</span>
          </p>
          <p>
            <span class="text-graphite-400">ROUTES </span>
            <span>{routeCount}</span>
          </p>
        </div>
      </DashboardPanel>

      {/* 7 — Site repo */}
      <DashboardPanel label="Site repo" span={7}>
        <div class="font-mono text-sm space-y-3">
          <p>
            <a
              href="https://github.com/chentianle1117/tianle-chen-site"
              target="_blank"
              rel="noopener noreferrer"
              class="text-oxide-400 hover:text-oxide-300 transition-colors"
            >
              github.com/chentianle1117/tianle-chen-site
            </a>
          </p>
          {recentCommits.length > 0 && (
            <ul class="text-xs space-y-1.5 mt-3">
              {recentCommits.map((c) => (
                <li class="grid grid-cols-[5rem_5rem_1fr] gap-3 items-baseline">
                  <span class="text-graphite-500">{c.date}</span>
                  <span class="text-oxide-400">{c.hash}</span>
                  <span class="text-graphite-200 truncate">{c.subject}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </DashboardPanel>

      {/* 8 — Colophon */}
      <DashboardPanel label="Colophon" span={5}>
        <p class="font-mono text-xs leading-relaxed text-graphite-300">
          This site is a static Astro build hosted at tianle-chen.com. Type by
          Production Type (Newsreader), Rasmus Andersson via Inter (Inter Tight),
          and IBM Plex (IBM Plex Mono). Latent-space hero uses OpenCLIP ViT-L/14 and
          UMAP. Source on GitHub.
        </p>
      </DashboardPanel>
    </div>
  </section>
  </div>
</BaseLayout>
