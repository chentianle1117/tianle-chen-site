---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionBreak from "../components/SectionBreak.astro";
import { getEntry } from "astro:content";
import fs from "node:fs";
import path from "node:path";

// Try to read /now content from the site collection. Fall back to placeholder.
let nowBody: string | null = null;
try {
  // @ts-ignore — collection may not have entry; getEntry returns undefined.
  const entry = await getEntry("site", "now");
  if (entry && (entry as any).body) {
    nowBody = String((entry as any).body).trim();
  }
} catch {
  nowBody = null;
}

// Headshot fallback — render only if file exists in /public
const portraitPath = path.resolve(process.cwd(), "public", "portrait.jpg");
let portraitExists = false;
try {
  portraitExists = fs.existsSync(portraitPath);
} catch {
  portraitExists = false;
}

// Canonical from W:\SecondBrain\Career\Resumes\Tianle_Chen_Resume_2026-04.md (April 2026 snapshot).
// Note resume reads HILOS Fellowship 2025-May → 2025-Dec, transitioning to FT 2026-06-08.
const experience: { date: string; line: string }[] = [
  { date: "2026-Jun—", line: "HILOS Studio · ML/AI Engineer (full-time, incoming)" },
  { date: "2025-May → 2025-Dec", line: "HILOS Studio · Machine Learning Graduate Fellow · Portland, OR" },
  { date: "2024-Aug → 2025-May", line: "CMU CodeLab · Mixed Reality Researcher (Immersive Tech in Digital Fabrication)" },
  { date: "2022-Jul → 2023-May", line: "NBBJ Architects · Junior Designer · Los Angeles, CA" },
  { date: "2021-May → 2024-May", line: "Rice CNT-Fiber Research Lab · Computational Research Assistant" },
];

const education: { date: string; line: string }[] = [
  { date: "2024-Aug → 2026-May", line: "Carnegie Mellon University · M.S. Computational Design (MSCD) · Pittsburgh, PA" },
  { date: "2018-Aug → 2024-May", line: "Rice University · B.Arch Architecture · Houston, TX · GPA 4.0 · Cum Laude" },
];

const recognition: { date: string; line: string }[] = [
  { date: "2024", line: "IASS 2024 Symposium · Segmental Ceramic Hollow Structures (Castellon)" },
  { date: "2024", line: "Margaret Everson-Fossi Traveling Fellowship · Rice Architecture" },
  { date: "2024", line: "STOA International Architects Inc. Award · Rice Architecture" },
  { date: "2024", line: "President Honor Roll (4 semesters) · Rice University" },
  { date: "2024", line: "Architecture Merit Scholarship · CMU" },
];
---

<BaseLayout
  title="About"
  description="David Chen — bio, trajectory, contact. CMU MSCD computational design thesis student; HILOS Studio ML/AI engineer; Rice architecture."
>
  <div class="page-with-rails">
    {/* Round-5 Fix 8: marginalia rails at >=1440 */}
    <aside class="page-rail page-rail-left" aria-hidden="true">
      <span class="rail-row">ABOUT</span>
      <span class="rail-row faint">DAVID CHEN · CMU MSCD</span>
    </aside>
    <aside class="page-rail page-rail-right">
      <a class="rail-row" href="#top" aria-label="Back to top">↑ TOP</a>
    </aside>

  {/* ============ HEADER + BIO — zone-base ============ */}
  <section class="zone-base">
    <article class="container-reading pt-16 md:pt-24 pb-12 md:pb-16">
      {/* Header */}
      <header class="mb-12 md:mb-16" data-reveal>
        <p class="mono-label mb-4">ABOUT · 2026</p>
        <h1
          class="text-balance"
          style="font-family: theme(fontFamily.display); font-size: var(--step-5); font-weight: 380; line-height: 1.05; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
        >
          About
        </h1>
      </header>

      {/* Bio + Headshot — float-right at md+ */}
      <section data-reveal>
        {portraitExists && (
          <img
            src="/portrait.jpg"
            alt="David Chen portrait"
            width="280"
            height="280"
            loading="lazy"
            class="md:float-right md:ml-8 md:mb-6 mb-6 w-[200px] h-[200px] md:w-[280px] md:h-[280px] object-cover grayscale hover:grayscale-0"
            style="border-radius: 6px; border: 1px solid rgb(var(--surface-border)); transition: filter 420ms cubic-bezier(0.22, 1, 0.36, 1);"
          />
        )}
        <p style="color: rgb(var(--text-secondary)); font-size: var(--step-1); line-height: 1.65;">
          David Chen <span style="font-size: 0.92em; opacity: 0.75;">(陳天樂)</span> is a computational designer and ML engineer working at the seam of generative AI and design tooling. He is finishing an MSCD thesis at CMU — <em>Semantic Canvas</em>, an interactive latent-space interface for AI-augmented footwear design. He joins HILOS Studio full-time as an ML/AI engineer in June 2026. Earlier he trained as an architect at Rice University and worked at NBBJ (Los Angeles), with research collaborations on fiber-based pavilions and ceramic hollow columns published at IASS 2024.
        </p>
        <div class="md:clear-right"></div>
      </section>
    </article>
  </section>

  {/* ============ NOW — zone-raised ============ */}
  <section class="zone-raised">
    <SectionBreak number="01" label="NOW" />
    <article class="container-reading pb-12 md:pb-16">
      <section data-reveal>
        <p class="mono-label mb-4">NOW · 2026-04</p>
        {nowBody ? (
          <div class="prose-custom" set:html={nowBody}></div>
        ) : (
          <p style="color: rgb(var(--text-secondary)); line-height: 1.65;">
            Closing out the Semantic Canvas thesis at CMU and shipping ML/AI work at HILOS Studio. Talking to teams building generative tools for designers and looking for full-time roles where computer vision, latent spaces, and design tooling meet.
          </p>
        )}
      </section>
    </article>
  </section>

  {/* ============ SELECTED EXPERIENCE — zone-base ============ */}
  <section class="zone-base">
    <SectionBreak number="02" label="EXPERIENCE" />
    <article class="container-reading pb-12 md:pb-16">
      <section data-reveal>
        <p class="mono-label mb-5">SELECTED EXPERIENCE</p>
        <ul class="font-mono text-sm leading-relaxed">
          {experience.map((row) => (
            <li
              class="grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-x-4 gap-y-1 py-2.5"
              style="border-bottom: 1px solid rgb(var(--surface-border));"
            >
              <span class="uppercase" style="color: rgb(var(--text-mono)); letter-spacing: 0.06em;">{row.date}</span>
              <span style="color: rgb(var(--text-primary));">{row.line}</span>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </section>

  {/* ============ EDUCATION — zone-raised ============ */}
  <section class="zone-raised">
    <SectionBreak number="03" label="EDUCATION" />
    <article class="container-reading pb-12 md:pb-16">
      <section data-reveal>
        <p class="mono-label mb-5">EDUCATION</p>
        <ul class="font-mono text-sm leading-relaxed">
          {education.map((row) => (
            <li
              class="grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-x-4 gap-y-1 py-2.5"
              style="border-bottom: 1px solid rgb(var(--surface-border));"
            >
              <span class="uppercase" style="color: rgb(var(--text-mono)); letter-spacing: 0.06em;">{row.date}</span>
              <span style="color: rgb(var(--text-primary));">{row.line}</span>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </section>

  {/* ============ RECOGNITION + CONTACT + CV — zone-base ============ */}
  <section class="zone-base">
    <SectionBreak number="04" label="RECOGNITION & CONTACT" />
    <article class="container-reading pb-16">
      {recognition.length > 0 && (
        <section class="mb-12 md:mb-16" data-reveal>
          <p class="mono-label mb-5">RECOGNITION</p>
          <ul class="font-mono text-sm leading-relaxed">
            {recognition.map((row) => (
              <li
                class="grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-x-4 gap-y-1 py-2.5"
                style="border-bottom: 1px solid rgb(var(--surface-border));"
              >
                <span class="uppercase" style="color: rgb(var(--text-mono)); letter-spacing: 0.06em;">{row.date}</span>
                <span style="color: rgb(var(--text-primary));">{row.line}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Contact */}
      <section class="mb-12 md:mb-16" data-reveal>
        <p class="mono-label mb-5">CONTACT</p>
        <ul class="font-mono text-sm space-y-3">
          <li class="grid grid-cols-[6.5rem_1fr] gap-4">
            <span class="uppercase" style="color: rgb(var(--text-mono)); letter-spacing: 0.06em;">LinkedIn</span>
            <a
              href="https://www.linkedin.com/in/tianle-chen"
              target="_blank"
              rel="noopener noreferrer"
              class="w-fit"
              style="color: rgb(var(--accent-rgb)); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgb(var(--accent-rgb) / 0.3);"
            >
              linkedin.com/in/tianle-chen
            </a>
          </li>
          <li class="grid grid-cols-[6.5rem_1fr] gap-4">
            <span class="uppercase" style="color: rgb(var(--text-mono)); letter-spacing: 0.06em;">Email</span>
            <button
              type="button"
              data-copy-email
              data-email="davidch2@andrew.cmu.edu"
              class="inline-flex items-center gap-2 w-fit"
              style="color: rgb(var(--text-primary)); background: transparent; border: 0; padding: 0; cursor: pointer; transition: color 200ms ease;"
            >
              <span>davidch2@andrew.cmu.edu</span>
              <i class="ph ph-copy" aria-hidden="true" data-copy-icon style="color: rgb(var(--text-mono));"></i>
              <span class="sr-only" data-copy-status>Click to copy</span>
            </button>
          </li>
          <li class="grid grid-cols-[6.5rem_1fr] gap-4">
            <span class="uppercase" style="color: rgb(var(--text-mono)); letter-spacing: 0.06em;">GitHub</span>
            <a
              href="https://github.com/chentianle1117"
              target="_blank"
              rel="noopener noreferrer"
              class="w-fit"
              style="color: rgb(var(--text-primary)); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgb(var(--text-mono) / 0.5);"
            >
              github.com/chentianle1117
            </a>
          </li>
        </ul>
      </section>

      {/* CV */}
      <section data-reveal>
        <p class="mono-label mb-5">CURRICULUM VITAE</p>
        <a href="/davidchen-cv.pdf" target="_blank" rel="noopener" class="btn btn-primary">
          <i class="ph ph-arrow-down" aria-hidden="true"></i>
          <span>Download CV (PDF)</span>
        </a>
        <p class="mono-label mt-3">LAST UPDATED 2026-04</p>
      </section>
    </article>
  </section>

  <script is:inline>
    (function () {
      const init = () => {
        const buttons = document.querySelectorAll("[data-copy-email]");
        buttons.forEach((btn) => {
          if ((btn).dataset.bound === "1") return;
          (btn).dataset.bound = "1";
          btn.addEventListener("click", async () => {
            const email = btn.getAttribute("data-email") || "";
            const icon = btn.querySelector("[data-copy-icon]");
            const status = btn.querySelector("[data-copy-status]");
            try {
              await navigator.clipboard.writeText(email);
              if (icon) {
                icon.classList.remove("ph-copy");
                icon.classList.add("ph-check");
              }
              if (status) status.textContent = "Copied";
              setTimeout(() => {
                if (icon) {
                  icon.classList.remove("ph-check");
                  icon.classList.add("ph-copy");
                }
                if (status) status.textContent = "Click to copy";
              }, 1800);
            } catch (e) {
              if (status) status.textContent = "Copy failed";
            }
          });
        });
      };
      init();
      document.addEventListener("astro:page-load", init);
    })();
  </script>
  </div>
</BaseLayout>
