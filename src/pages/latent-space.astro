---
// Round-9p: dedicated /latent-space page. Mirrors the home-page hero
// (HeroNavigator) but stripped of the prologue + below-the-fold sections,
// so visitors arriving from the nav land in the full-fledged latent-space
// instrument with no scroll context above it. The home page keeps its
// version as the on-arrival demo; this page is the "open the tool" path.
import BaseLayout from "../layouts/BaseLayout.astro";
// @ts-ignore - HeroNavigator is a React island
import HeroNavigator from "../components/hero/HeroNavigator";
import { getProjectCounts } from "../lib/projectCounts";

const { counts: pc } = await getProjectCounts();
// The scatter (HeroNavigator) plots every published project — work + architecture.
const totalCount = pc.work + pc.arch;
const workYearRange = "2021—2026";
---

<BaseLayout
  title="Latent Space"
  description="An interactive latent-space view of Tianle Chen's projects. Pick semantic axes (e.g. ML/Latent ↔ Algorithmic/Parametric) and watch projects re-arrange by meaning."
>
  {/* Intro: tighter than the home prologue. Frames "this IS a tool" without
      the large headline that sits on /. */}
  <section class="zone-base" style="border-bottom: 1px solid rgb(var(--surface-border));">
    <div class="container-display pt-8 md:pt-12 pb-5 md:pb-7 latent-intro-grid">
      <div class="latent-intro-copy">
        <p class="mono-label" style="color: rgb(var(--text-mono));">
          INTERACTIVE · DESIGNER-TYPED AXES · {String(totalCount).padStart(2, "0")} PROJECTS · {workYearRange}
        </p>
        <h1
          class="mt-3"
          style="font-family: theme(fontFamily.display); font-size: var(--step-2); font-weight: 380; line-height: 1.18; letter-spacing: -0.005em; color: rgb(var(--text-primary));"
        >
          Latent project space.
        </h1>
        <p
          style="font-family: theme(fontFamily.sans); font-size: var(--step-0); font-weight: 350; line-height: 1.55; color: rgb(var(--text-secondary)); max-width: 60ch; margin-top: 0.7rem;"
        >
          Pick two semantic axes from the side panel — projects reposition by
          dot-product against the axis vectors. Hover any tile for the case
          study. The same projection method drives my MSCD thesis tool;
          this page is the smallest possible version of it, applied to my
          own portfolio.
        </p>
      </div>

      <aside class="latent-intro-aside" aria-hidden="true">
        <p class="mono-label" style="color: rgb(var(--text-mono)); margin-bottom: 0.65rem;">↓ TRY</p>
        <ul style="list-style: none; padding: 0; margin: 0; font-family: theme(fontFamily.mono); font-size: var(--step--1); line-height: 1.85; color: rgb(var(--text-secondary)); letter-spacing: 0.06em;">
          <li><span style="color: rgb(var(--text-mono));">01 ·</span> SWITCH X / Y AXIS</li>
          <li><span style="color: rgb(var(--text-mono));">02 ·</span> HOVER LEGEND TO FILTER</li>
          <li><span style="color: rgb(var(--text-mono));">03 ·</span> CLICK TILE → CASE STUDY</li>
          <li><span style="color: rgb(var(--text-mono));">04 ·</span> COMPARE SEMANTIC ↔ UMAP / PCA</li>
        </ul>
      </aside>
    </div>

    <HeroNavigator client:visible />
  </section>

  {/* Footer affordance: send the visitor onward instead of dead-ending the page. */}
  <section class="zone-raised">
    <div class="container-display py-12 md:py-16 flex flex-wrap items-baseline gap-x-8 gap-y-3 justify-between">
      <p class="mono-label" style="color: rgb(var(--text-mono));">
        WANT THE FULL CASE STUDIES?
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/work" class="mono-label nav-onward">→ All projects</a>
        <a href="/thesis" class="mono-label nav-onward">→ Thesis (Semantic Canvas)</a>
        <a href="/about" class="mono-label nav-onward">→ About</a>
      </div>
    </div>
  </section>

  <style>
    .latent-intro-grid {
      display: block;
    }
    .latent-intro-aside { display: none; }
    @media (min-width: 1280px) {
      .latent-intro-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(240px, 22rem);
        gap: 4rem;
        align-items: start;
      }
      .latent-intro-aside {
        display: block;
        padding-top: 0.4rem;
        border-left: 1px solid rgb(var(--surface-border));
        padding-left: 2rem;
      }
    }
    .nav-onward {
      color: rgb(var(--text-primary));
      transition: color 200ms ease;
    }
    .nav-onward:hover {
      color: rgb(var(--accent-rgb));
    }
  </style>
</BaseLayout>
