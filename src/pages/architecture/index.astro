---
// @ts-nocheck
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionBreak from "../../components/SectionBreak.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjectCounts, ARCHITECTURE_SLUGS } from "../../lib/projectCounts";

// Round-6: /architecture now uses ProjectCard (uniform 4/3 grid) — same
// component as /work, so visual rhythm is identical across the site.
const { arch: archProjects, counts, years: yearRanges } = await getProjectCounts();
const architectureSlugs = Array.from(ARCHITECTURE_SLUGS);

const architecture = architectureSlugs
  .map((slug) => archProjects.find((p) => p.data.slug === slug || (p as any).slug === slug))
  .filter(Boolean);

const archCount = counts.arch;
const archYearRange = `${yearRanges.arch.min}—${yearRanges.arch.max}`;
const archKicker = `${archCount} PROJECTS · ${archYearRange} · RICE UNIVERSITY`;
---

<BaseLayout
  title="Architecture"
  description="Selected architecture work from Rice University, 2021–2024 — including IASS 2024 published research with Prof. Castellon."
>
  {/* Header */}
  <section class="zone-base">
    <div class="container-wide pt-16 md:pt-24 pb-8">
      <p class="mono-label mb-4">{archKicker}</p>
      <h1
        class="mb-6 max-w-3xl"
        style="font-family: theme(fontFamily.display); font-size: var(--step-5); font-weight: 380; line-height: 1.05; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
      >
        Architecture
      </h1>
      <p class="max-w-[68ch]" style="color: rgb(var(--text-secondary)); font-size: var(--step-1); line-height: 1.55;">
        Studio and research work from the BArch — parametric form-finding, ceramic-hollow column fabrication, generative urbanism, and robotic wire bending. One project, the fiber-based parametric pavilion, was published at IASS 2024 with Prof. Juan Jose Castellon.
      </p>
    </div>
  </section>

  <section class="zone-raised">
    <SectionBreak label="PROJECTS" />

    <div class="container-wide pb-24 md:pb-32">
      {architecture.length === 0 ? (
        <p class="font-mono text-sm" style="color: rgb(var(--text-mono));">
          Architecture projects sync from the vault. Run <code>npm run sync</code>.
        </p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-12" data-stagger>
          {architecture.map((project, i) => (
            <div data-reveal>
              <ProjectCard project={project} eager={i < 3} />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
