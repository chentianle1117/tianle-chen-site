---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Not found · Tianle Chen"
  description="That route doesn't exist on tianle-chen.com."
>
  <main class="min-h-[60vh] grid place-items-center container-display py-24">
    <div class="text-center max-w-prose">
      <p class="mono-label mb-6" style="color: rgb(var(--text-mono));">404</p>
      <h1
        class="mb-6"
        style="font-family: theme(fontFamily.display); font-size: var(--step-5); font-weight: 380; line-height: 1.05; letter-spacing: -0.01em; color: rgb(var(--text-primary));"
      >
        Not found
      </h1>
      <p class="mb-8" style="color: rgb(var(--text-secondary)); font-size: var(--step-1); line-height: 1.55;">
        This route isn't in the index.
      </p>
      <div class="flex justify-center gap-3 flex-wrap">
        <a href="/" class="btn">← Home</a>
        <a href="/work" class="btn">View work</a>
      </div>
    </div>
  </main>
</BaseLayout>
