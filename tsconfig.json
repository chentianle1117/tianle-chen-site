{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "~/*": ["src/*"]
    },
    "noImplicitAny": false,
    "strictNullChecks": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*", "astro.config.mjs", "tailwind.config.ts"],
  "exclude": ["dist", "node_modules"]
}
